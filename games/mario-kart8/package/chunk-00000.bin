// Online rooms over the mk8-server WebSocket (docs/NETWORK.md ¬ß5). The protocol, room state and
// lockstep driver live in wasm (`NetClient`, crate mk8-net); this module owns the socket,
// shuttles bytes, reconnects (the client rejoins its room automatically) and fans out events.
//
// Server: ws(s)://<page host>/ws, or `?ws=ws://host:port/ws` (development: page and romfs served
// from another origin, e.g. tools/web-online-smoke.mjs).
//
// Interface:
//   connect(profile)            open the socket (idempotent); profile = { name, combo: [d, b, t, g] }
//   on(type, cb)                events of NetClient.next_event (welcome joined left room face
//                               race_start race_ended desync error) + 'connection' {connected}
//   createRoom() / joinRoom(code) / leaveRoom()
//   setProfile(profile) / setReady(bool) / setFace(Uint8Array | null)
//   setSettings(settings) / startRace(settings)   host; settings JSON as in NETWORK.md
//   raceDone() / endRace()
//   racing()                    a race (lockstep) is running for this client
//   tick(sx, sy, buttons, maxSteps) -> Uint8Array   one 60 Hz tick (flat sim commands for app.step_net)
//   reportChecksum(frame, hash) after simulating a frame with NetClient.checksum_due(frame)
//   face(player) -> Blob | null, room() / race() (parsed JSON), myId(), buffered(), flush()
//   maxPlayers()                the server's cap on a room's grid size ("Racers"; 2..=255, 12 for
//                               a build without the setting), also in the 'welcome' event
//   sendSignal(to, json) / on('signal', {from, data})   WebRTC signaling for www/live.js
//   httpUrl(path)               URL on the room server (e.g. /ice.json)
// The wasm glue is NOT imported here: main.js initialises one module instance and publishes it
// as window.__mk8Pkg. A second import (e.g. a stale cached mk8_web.js) would be a separate,
// uninitialised instance ("wasm is undefined").
const pkg = () => {
  const m = window.__mk8Pkg;
  if (!m || !m.NetClient) throw new Error('the game module is not initialised yet (reload the page)');
  return m;
};
const NetClient = new Proxy(function NetClient() {}, { construct: (_t, args) => new (pkg().NetClient)(...args) });
const net_parse_room_code = (s) => pkg().net_parse_room_code(s);

let client = null;
let ws = null;
let everOpen = false;
let connected = false;
let closedByUs = false;
const handlers = new Map();
const params = new URLSearchParams(location.search);

function wsUrl() {
  const o = params.get('ws');
  if (o) return o;
  return `${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws`;
}

function emit(type, ev) { for (const cb of handlers.get(type) || []) { try { cb(ev); } catch (e) { console.error(e); } } }
export function on(type, cb) { if (!handlers.has(type)) handlers.set(type, []); handlers.get(type).push(cb); }

export function flush() {
  // While the socket is (re)connecting, messages stay queued in the client (on reconnect
  // `reconnected()` replaces them with Hello + Rejoin).
  if (!client || !ws || ws.readyState !== 1) return;
  for (let m; (m = client.next_outgoing()) !== undefined;) ws.send(m);
}
function drain() {
  for (let j; (j = client.next_event()) !== undefined;) {
    let ev;
    try { ev = JSON.parse(j); } catch { continue; }
    emit(ev.type, ev);
  }
}

/** Connection diagnostics for the lobby status line and `window.__mk8Net`. */
const diag = { errors: 0, closes: 0, failedOpens: 0, lastClose: null, url: null };
window.__mk8Net = diag;

function open() {
  closedByUs = false;
  diag.url = wsUrl();
  let sock;
  try { sock = new WebSocket(wsUrl()); } catch (e) { emit('error', { code: 'connect', message: String(e.message || e) }); return; }
  ws = sock;
  sock.binaryType = 'arraybuffer';
  sock.onopen = () => {
    if (everOpen) client.reconnected(); // Hello + Rejoin (same player, same kart)
    everOpen = true;
    connected = true;
    emit('connection', { connected: true });
    flush();
  };
  sock.onmessage = (e) => {
    if (!(e.data instanceof ArrayBuffer)) return;
    try { client.on_message(new Uint8Array(e.data)); } catch (err) { console.error('net: bad message', err); }
    flush();
    drain();
  };
  sock.onerror = () => { diag.errors++; };
  sock.onclose = (e) => {
    if (ws !== sock) return;
    const was = connected;
    connected = false;
    diag.lastClose = { code: e.code, reason: e.reason || '', clean: e.wasClean, at: Date.now() };
    diag.closes++;
    if (!was) diag.failedOpens++;
    console.info(`net: socket closed (code ${e.code}${e.reason ? ', ' + e.reason : ''}); ${closedByUs ? 'closed by us' : 'reconnecting in 1 s'}`);
    if (was || !closedByUs) emit('connection', { connected: false, code: e.code, reason: e.reason || '' });
    if (!closedByUs) setTimeout(open, 1000);
  };
}

/** Open the connection once (later calls only update the profile). */
export function connect(profile) {
  if (!client) {
    const c = profile.combo;
    client = new NetClient(profile.name, c[0], c[1], c[2], c[3]);
    open();
  } else setProfile(profile);
}
export const isConnected = () => connected;
export const started = () => client !== null;

export function parseCode(s) { return net_parse_room_code(String(s || '')) ?? null; }
export function createRoom() { client.create_room(); flush(); }
export function joinRoom(code) {
  const c = parseCode(code);
  if (!c) throw new Error('that is not a room code (6 letters / digits)');
  client.join_room(c); flush();
}
export function leaveRoom() { if (client) { client.leave_room(); flush(); } }
export function setProfile(p) { if (client) { const c = p.combo; client.set_profile(p.name, c[0], c[1], c[2], c[3]); flush(); } }
export function setReady(r) { client.set_ready(!!r); flush(); }
export function setFace(bytes) { if (!client) return; if (bytes) client.set_face(bytes); else client.clear_face(); flush(); }
export function setSettings(s) { client.set_settings(JSON.stringify(s)); flush(); }
export function startRace(s) { if (s) client.set_settings(JSON.stringify(s)); client.start_race(); flush(); }
export function endRace() { client.end_race(); flush(); }
/** WebRTC signaling payload (string, <= 16 KB) for room member `to`. */
export function sendSignal(to, data) { if (client) { client.send_signal(to, data); flush(); } }
/** HTTP(S) URL on the room server (e.g. '/ice.json'). */
export function httpUrl(path) { const u = new URL(wsUrl()); u.protocol = u.protocol === 'wss:' ? 'https:' : 'http:'; u.pathname = path; u.search = ''; return u.href; }
export function raceDone() { client.race_done(); flush(); }

export function racing() { return !!client && client.racing(); }
export function tick(sx, sy, buttons, maxSteps) { return client.tick(sx, sy, buttons, maxSteps); }
export function reportChecksum(frame, hash) { client.report_checksum(frame, hash); }
export function buffered() { return client ? client.buffered() : 0; }
export function raceBytes() { return client ? client.race_bytes() : undefined; }
export function myId() { return client ? client.my_id() : undefined; }
/** The server's grid-size cap (from Welcome; 12 when this build predates the setting). */
export function maxPlayers() { return client && typeof client.max_players === 'function' ? client.max_players() : 12; }
export function room() { const j = client && client.room_json(); return j ? JSON.parse(j) : null; }
export function race() { const j = client && client.race_json(); return j ? JSON.parse(j) : null; }
export function face(player) {
  const b = client && client.face(player);
  return b ? new Blob([b], { type: client.face_mime(player) || 'image/jpeg' }) : null;
}
const $ = (id) => document.getElementById(id);
const button = $('install'), status = $('status'), info = $('capacity');
let manifest;

async function readManifest() {
  const response = await fetch('./package/manifest.json', { cache: 'no-store' });
  if (!response.ok) throw new Error(`Package manifest request failed (${response.status}).`);
  manifest = await response.json();
  if (manifest.format !== 'mk8-web-package-v1') throw new Error('Unrecognized package format.');
  const total = manifest.chunks.reduce((sum, chunk) => sum + chunk.size, 0);
  const max = Math.max(...manifest.chunks.map((chunk) => chunk.size));
  if (max > 19_000_000) throw new Error('A package chunk exceeds the 19 MB limit.');
  info.textContent = `${Object.keys(manifest.files).length.toLocaleString()} files in ${manifest.chunks.length.toLocaleString()} chunks (${(total / 1e9).toFixed(2)} GB). Chunks are fetched only as the game needs them; the full package is not copied into browser storage.`;
}

async function launch() {
  if (!window.isSecureContext || !('serviceWorker' in navigator)) {
    throw new Error('Open this page from localhost or HTTPS. The package loader needs a service worker.');
  }
  button.disabled = true;
  status.textContent = 'Connecting the game to the split package‚Ä¶';
  const swUrl = new URL('./package-sw.js?v=2', location.href);
  await navigator.serviceWorker.register(swUrl.href, { scope: './' });
  await navigator.serviceWorker.ready;
  if (!navigator.serviceWorker.controller || navigator.serviceWorker.controller.scriptURL !== swUrl.href) {
    await new Promise((resolve, reject) => {
      const timeout = setTimeout(() => reject(new Error('The package service worker did not take control. Reload this page and try again.')), 15000);
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        const controller = navigator.serviceWorker.controller;
        if (controller && controller.scriptURL === swUrl.href) { clearTimeout(timeout); resolve(); }
      });
    });
  }
  status.textContent = 'Starting the game. Required chunks will load as needed‚Ä¶';
  location.replace(new URL('./index.html?romfs=./romfs/&package=1', location.href));
}

button.addEventListener('click', () => launch().catch((err) => {
  status.textContent = `Could not start: ${err.message}`;
  button.disabled = false;
}));
readManifest().catch((err) => { status.textContent = `Package unavailable: ${err.message}`; button.disabled = true; });
#!/usr/bin/env node
// Build a raw, streamable package from this site's files. Chunks stay below 19 MB so
// they can be hosted by services with per-file upload limits.
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');

const ROOT = path.resolve(__dirname);
const OUT = path.join(ROOT, 'package');
const LIMIT = 19_000_000;
const MIME = {
  '.html': 'text/html; charset=utf-8', '.htm': 'text/html; charset=utf-8',
  '.css': 'text/css; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.mjs': 'text/javascript; charset=utf-8',
  '.json': 'application/json; charset=utf-8', '.webmanifest': 'application/manifest+json', '.wasm': 'application/wasm',
  '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.gif': 'image/gif', '.svg': 'image/svg+xml',
  '.webp': 'image/webp', '.avif': 'image/avif', '.ico': 'image/x-icon', '.woff': 'font/woff', '.woff2': 'font/woff2',
  '.ttf': 'font/ttf', '.otf': 'font/otf', '.mp3': 'audio/mpeg', '.ogg': 'audio/ogg', '.wav': 'audio/wav',
  '.mp4': 'video/mp4', '.webm': 'video/webm', '.pdf': 'application/pdf', '.xml': 'application/xml',
};

async function walk(dir, rel = '') {
  const out = [];
  for (const ent of await fs.promises.readdir(dir, { withFileTypes: true })) {
    if (rel === '' && ent.name === 'package') continue; // never package prior build output
    const childRel = rel ? `${rel}/${ent.name}` : ent.name;
    const full = path.join(dir, ent.name);
    if (ent.isDirectory()) out.push(...await walk(full, childRel));
    else if (ent.isFile()) out.push({ full, path: childRel.split(path.sep).join('/') });
  }
  return out;
}

async function main() {
  await fs.promises.mkdir(OUT, { recursive: true });
  const files = (await walk(ROOT)).sort((a, b) => a.path.localeCompare(b.path));
  const manifest = { format: 'mk8-web-package-v1', chunkLimit: LIMIT, packageId: '', chunks: [], files: {} };
  let chunkIndex = -1, chunkBytes = 0, chunkHash, handle;
  async function openChunk() {
    if (handle) {
      await handle.sync(); await handle.close();
      manifest.chunks[chunkIndex].sha256 = chunkHash.digest('hex');
    }
    chunkIndex++;
    const name = `chunk-${String(chunkIndex).padStart(5, '0')}.bin`;
    handle = await fs.promises.open(path.join(OUT, name), 'w');
    chunkBytes = 0; chunkHash = crypto.createHash('sha256');
    manifest.chunks.push({ name, size: 0, sha256: '' });
  }
  async function writeBytes(bytes, fileRecord) {
    let at = 0;
    while (at < bytes.length) {
      if (chunkIndex < 0 || chunkBytes === LIMIT) await openChunk();
      const take = Math.min(bytes.length - at, LIMIT - chunkBytes);
      const part = bytes.subarray(at, at + take);
      let written = 0;
      while (written < part.length) {
        const result = await handle.write(part, written, part.length - written, chunkBytes + written);
        if (!result.bytesWritten) throw new Error('Package chunk write made no progress');
        written += result.bytesWritten;
      }
      chunkHash.update(part);
      const previous = fileRecord.parts[fileRecord.parts.length - 1];
      if (previous && previous.chunk === chunkIndex && previous.offset + previous.length === chunkBytes) previous.length += take;
      else fileRecord.parts.push({ chunk: chunkIndex, offset: chunkBytes, length: take });
      chunkBytes += take; at += take;
      manifest.chunks[chunkIndex].size = chunkBytes;
    }
  }

  let total = 0;
  for (let i = 0; i < files.length; i++) {
    const f = files[i], stat = await fs.promises.stat(f.full);
    const record = { size: stat.size, type: MIME[path.extname(f.path).toLowerCase()] || 'application/octet-stream', parts: [] };
    manifest.files[f.path] = record;
    const stream = fs.createReadStream(f.full, { highWaterMark: 1024 * 1024 });
    for await (const bytes of stream) await writeBytes(bytes, record);
    total += stat.size;
    if ((i + 1) % 250 === 0 || i + 1 === files.length) {
      process.stderr.write(`Packed ${i + 1}/${files.length} files (${(total / 1e9).toFixed(2)} GB)\n`);
    }
  }
  if (handle) {
    await handle.sync(); await handle.close();
    manifest.chunks[chunkIndex].sha256 = chunkHash.digest('hex');
  }
  const identity = { format: manifest.format, chunks: manifest.chunks, files: manifest.files };
  manifest.packageId = crypto.createHash('sha256').update(JSON.stringify(identity)).digest('hex');
  const tmp = path.join(OUT, 'manifest.json.tmp');
  await fs.promises.writeFile(tmp, JSON.stringify(manifest));
  await fs.promises.rename(tmp, path.join(OUT, 'manifest.json'));
  console.log(`Created ${manifest.chunks.length} chunks (max ${LIMIT.toLocaleString()} bytes), ${files.length} files, ${(total / 1e9).toFixed(2)} GB total.`);
  console.log(`Package: ${OUT}`);
}

main().catch((err) => { console.error(err); process.exitCode = 1; });
/* Serve the installed package as the original site's files, fetching only needed chunks. */
'use strict';

const SCOPE = new URL(self.registration.scope);
const MAX_MEMORY_CHUNKS = 4;
let manifestPromise;
// A small in-memory LRU avoids refetching adjacent file data without persistent browser storage.
const chunkCache = new Map();

self.addEventListener('install', (event) => event.waitUntil(self.skipWaiting()));
self.addEventListener('activate', (event) => event.waitUntil(self.clients.claim()));

async function manifest() {
  if (!manifestPromise) {
    manifestPromise = fetch(new URL('package/manifest.json', SCOPE), { cache: 'no-store' }).then(async (r) => {
      if (!r.ok) throw new Error(`Package manifest request failed (${r.status})`);
      const value = await r.json();
      if (value.format !== 'mk8-web-package-v1') throw new Error('Unrecognized package format');
      return value;
    }).catch((err) => { manifestPromise = null; throw err; });
  }
  return manifestPromise;
}

function chunkData(index, info) {
  if (chunkCache.has(index)) {
    const cached = chunkCache.get(index);
    chunkCache.delete(index); chunkCache.set(index, cached);
    return cached;
  }
  const promise = (async () => {
    const url = new URL(`package/${encodeURIComponent(info.name)}`, SCOPE);
    const response = await fetch(url, { cache: 'no-store' });
    if (!response.ok) throw new Error(`${info.name} request failed (${response.status})`);
    const bytes = await response.arrayBuffer();
    if (bytes.byteLength !== info.size) throw new Error(`${info.name} has ${bytes.byteLength} bytes; expected ${info.size}`);
    const digest = await crypto.subtle.digest('SHA-256', bytes);
    const sha256 = [...new Uint8Array(digest)].map((n) => n.toString(16).padStart(2, '0')).join('');
    if (sha256 !== info.sha256) throw new Error(`${info.name} failed its SHA-256 check`);
    return bytes;
  })();
  chunkCache.set(index, promise);
  while (chunkCache.size > MAX_MEMORY_CHUNKS) chunkCache.delete(chunkCache.keys().next().value);
  promise.catch(() => { if (chunkCache.get(index) === promise) chunkCache.delete(index); });
  return promise;
}

function relativePath(url) {
  if (!url.pathname.startsWith(SCOPE.pathname)) return null;
  try { return decodeURIComponent(url.pathname.slice(SCOPE.pathname.length)); }
  catch { return null; }
}

async function packageResponse(request) {
  const url = new URL(request.url);
  const rel = relativePath(url);
  if (rel === null || (request.method !== 'GET' && request.method !== 'HEAD')) return null;
  const pkg = await manifest();
  const key = rel.endsWith('/') ? `${rel}index.html` : rel;
  const entry = pkg.files[key];
  if (!entry) return null;

  const parts = await Promise.all(entry.parts.map(async (part) => {
    const buffer = await chunkData(part.chunk, pkg.chunks[part.chunk]);
    return new Uint8Array(buffer, part.offset, part.length);
  }));
  const body = new Blob(parts, { type: entry.type });
  const headers = new Headers({ 'Content-Type': entry.type, 'Content-Length': String(entry.size), 'Accept-Ranges': 'bytes', 'Cache-Control': 'no-store' });
  const range = request.headers.get('Range');
  if (range && /^bytes=\d*-\d*$/.test(range)) {
    const [a, b] = range.slice(6).split('-');
    let start = a ? Number(a) : Math.max(0, entry.size - Number(b));
    let end = a ? (b ? Number(b) : entry.size - 1) : entry.size - 1;
    if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start < 0 || start > end || start >= entry.size) {
      headers.set('Content-Range', `bytes */${entry.size}`);
      return new Response(null, { status: 416, headers });
    }
    end = Math.min(end, entry.size - 1);
    headers.set('Content-Length', String(end - start + 1));
    headers.set('Content-Range', `bytes ${start}-${end}/${entry.size}`);
    return new Response(request.method === 'HEAD' ? null : body.slice(start, end + 1), { status: 206, headers });
  }
  return new Response(request.method === 'HEAD' ? null : body, { headers });
}

self.addEventListener('fetch', (event) => {
  if (event.request.method !== 'GET' && event.request.method !== 'HEAD') return;
  const url = new URL(event.request.url);
  // Package chunks must reach the static host directly to avoid recursively intercepting them.
  if (url.origin !== SCOPE.origin || url.pathname.includes('/package/')) return;
  event.respondWith((async () => {
    try {
      const response = await packageResponse(event.request);
      return response || fetch(event.request);
    } catch (err) {
      return new Response(`Package read failed: ${err.message}`, { status: 500, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
    }
  })());
});
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#061a44">
<title>MK8 Web package installer</title>
<style>
  :root { color-scheme: dark; font: 16px/1.5 system-ui, sans-serif; background: #061a44; color: #fff; }
  body { max-width: 760px; margin: 8vh auto; padding: 24px; }
  h1 { color: #ffd400; }
  p { color: #d7e3fb; }
  button { border: 3px solid #fff; border-radius: 12px; background: #ffd400; color: #061a44; padding: 12px 20px; font: 900 18px system-ui; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  progress { width: 100%; height: 22px; margin: 18px 0 8px; accent-color: #ffd400; }
  #status { min-height: 3em; white-space: pre-wrap; overflow-wrap: anywhere; }
  .small { font-size: 13px; }
</style>
</head>
<body>
<h1>MK8 Web offline package</h1>
<p>The game files stay on the server. A service worker fetches only the small package chunks needed for each game file, then serves the files at their usual URLs.</p>
<p id="capacity" class="small"></p>
<button id="install">Launch game</button>
<p id="status" role="status">Ready.</p>
<script type="module" src="./package-loader.js"></script>
</body>
</html>
// Where the wasm bundle's files are (docs/NETWORK.md ¬ß1). The build names them by content hash
// (pkg/mk8_web.<hash>.js, pkg/mk8_web_bg.<hash>.wasm, pkg/mk8_audio_worklet.<hash>.wasm; served
// immutable) and writes pkg/manifest.json { "<unhashed name>": "<hashed name>" }. The page
// resolves every bundle file through the manifest, fetched fresh on every load (`no-store`, and
// the server sends it `no-cache`), so a deploy can never pair this page with an hour-old cached
// bundle: a new build is a new set of names. A pkg/ without a manifest (an older build) falls
// back to the unhashed names.
const PKG_DIR = '../pkg/';
let manifest = null;

/** The manifest, `{}` when there is none (one fetch per page load). */
export function pkgManifest() {
  if (!manifest) {
    manifest = (async () => {
      const url = new URL(PKG_DIR + 'manifest.json', import.meta.url);
      try {
        const r = await fetch(url, { cache: 'no-store' });
        if (r.ok) {
          const m = await r.json();
          if (m && typeof m === 'object' && !Array.isArray(m)) return m;
          console.warn('pkg/manifest.json is not an object; using the unhashed bundle names');
        } else if (r.status !== 404) {
          console.warn(`pkg/manifest.json: HTTP ${r.status}; using the unhashed bundle names`);
        }
      } catch (e) {
        console.warn('pkg/manifest.json unavailable; using the unhashed bundle names', e);
      }
      return {};
    })();
  }
  return manifest;
}

/** URL of a bundle file by its unhashed name (`'mk8_web.js'`, `'mk8_web_bg.wasm'`, ...). */
export async function pkgUrl(name) {
  const m = await pkgManifest();
  const mapped = m[name];
  // A manifest entry is a plain file name next to the manifest; anything else is ignored.
  const file = typeof mapped === 'string' && /^[\w.-]+$/.test(mapped) ? mapped : name;
  return new URL(PKG_DIR + file, import.meta.url);
}
