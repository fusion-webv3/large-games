struct ParticleUniforms {
    view_proj: mat4x4<f32>,
    right: vec4<f32>,
    up: vec4<f32>,
    fwd: vec4<f32>,
    // x: 1 = sRGB-encode output (linear target), y: intensity multiplier
    params: vec4<f32>,
};
@group(0) @binding(0) var<uniform> u: ParticleUniforms;
@group(0) @binding(1) var t_sprite: texture_2d<f32>;
@group(0) @binding(2) var s_sprite: sampler;

struct VsIn {
    @builtin(vertex_index) vi: u32,
    @location(0) pos_size: vec4<f32>,
    @location(1) color: vec4<f32>,
    @location(2) vel_stretch: vec4<f32>,
};
struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) uv: vec2<f32>,
    @location(1) color: vec4<f32>,
};

@vertex
fn vs_main(v: VsIn) -> VsOut {
    var corners = array<vec2<f32>, 6>(
        vec2<f32>(-1.0, -1.0), vec2<f32>(1.0, -1.0), vec2<f32>(1.0, 1.0),
        vec2<f32>(-1.0, -1.0), vec2<f32>(1.0, 1.0), vec2<f32>(-1.0, 1.0),
    );
    let c = corners[v.vi % 6u];
    let size = v.pos_size.w;
    // Velocity in the camera plane: the quad's long axis (camera right when it is too short).
    let vel = v.vel_stretch.xyz;
    let vp = vel - dot(vel, u.fwd.xyz) * u.fwd.xyz;
    let speed = length(vp);
    var ax = u.right.xyz;
    var ay = u.up.xyz;
    var len = size;
    if (speed > 1e-4 && v.vel_stretch.w > 0.0) {
        ax = vp / speed;
        ay = normalize(cross(u.fwd.xyz, ax));
        len = size * (1.0 + speed * v.vel_stretch.w);
    }
    let world = v.pos_size.xyz + ax * (c.x * len) + ay * (c.y * size);
    var o: VsOut;
    o.clip = u.view_proj * vec4<f32>(world, 1.0);
    o.uv = c * 0.5 + vec2<f32>(0.5, 0.5);
    o.color = v.color;
    return o;
}

fn srgb_encode(c: vec3<f32>) -> vec3<f32> {
    let lo = c * 12.92;
    let hi = 1.055 * pow(c, vec3<f32>(1.0 / 2.4)) - 0.055;
    return select(hi, lo, c <= vec3<f32>(0.0031308));
}

@fragment
fn fs_main(i: VsOut) -> @location(0) vec4<f32> {
    let m = textureSample(t_sprite, s_sprite, i.uv).r;
    var rgb = clamp(i.color.rgb * (i.color.a * m * u.params.y), vec3<f32>(0.0), vec3<f32>(1.0));
    if (u.params.x > 0.5) {
        rgb = srgb_encode(rgb);
    }
    return vec4<f32>(rgb, 0.0);
}
