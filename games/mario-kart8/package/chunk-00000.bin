}// Ad slots (index.html `.ad-slot[data-ad]`, styled in menu.css): banners on the homemade menu and
// towers in columns beside the game (main.js's resize() asks adGutter() for their width). Google
// AdSense: index.html loads adsbygoogle.js; each slot becomes a fixed-size display unit
// (<ins class="adsbygoogle">) the first time it is on screen. AdSense can't size a unit inside a
// display:none parent, and pages that are display:none never intersect (menu pages away from them,
// #home during races, the towers whenever the home menu is up or the window has no room).
const CLIENT = 'ca-pub-3274826616160862';
// Ad unit ids (AdSense > Ads > By ad unit > Display ads, fixed size): a size without one stays an
// empty placeholder, and the towers beside the game stay off (the canvas keeps the full width).
const UNITS = {
  '728x90': '',
  '468x60': '',
  '320x50': '',
  '300x250': '',
  '160x600': '',
  '160x300': '',
};
// The "banner" slot's size by viewport width (same breakpoints as menu.css).
const BANNERS = [['(min-width: 1101px)', '728x90'], ['(min-width: 521px)', '468x60'], ['all', '320x50']];
// The "tower" slots beside the game (index.html .ad-gutter): the tallest that fits the window.
const TOWERS = [[620, '160x600'], [320, '160x300']];
const GUTTER = 176; // a 160-wide tower + 8px each side

function tower(wh) {
  const t = TOWERS.find(([minH]) => wh >= minH);
  return t && UNITS[t[1]] ? t[1] : null;
}

function size(slot) {
  if (slot.dataset.ad === 'tower') return tower(window.innerHeight);
  if (slot.dataset.ad !== 'banner') return slot.dataset.ad;
  return BANNERS.find(([q]) => matchMedia(q).matches)[1];
}

// Called by main.js's resize(): the width to keep clear on each side of the game canvas for the
// towers, or 0 (no tower unit, a touch screen, or a window too small to give up 2 x 176px).
export function adGutter(ww, wh) {
  const on = !matchMedia('(pointer: coarse)').matches && ww >= 1100 && tower(wh) !== null;
  document.body.classList.toggle('ad-gutters', on);
  return on ? GUTTER : 0;
}

function fill(slot) {
  const fmt = size(slot);
  const unit = fmt && UNITS[fmt];
  if (!unit) return; // no ad unit for this size (yet)
  const [w, h] = fmt.split('x').map(Number);
  const ins = document.createElement('ins');
  ins.className = 'adsbygoogle';
  ins.style.cssText = `display:inline-block;width:${w}px;height:${h}px`;
  ins.dataset.adClient = CLIENT;
  ins.dataset.adSlot = unit;
  slot.style.width = `${w}px`; slot.style.height = `${h}px`;
  slot.replaceChildren(ins);
  slot.classList.add('filled');
  try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) { console.warn('adsense:', e); }
}

const seen = new IntersectionObserver((entries) => {
  for (const e of entries) {
    if (!e.isIntersecting) continue;
    seen.unobserve(e.target);
    fill(e.target);
  }
});
for (const slot of document.querySelectorAll('.ad-slot[data-ad]')) seen.observe(slot);
// AudioWorklet side of the game audio (www/audio.js, docs/AUDIO.md ¬ß5).
//
// Two modes, decided by the page:
// * engine (preferred): the mk8-audio mixer itself runs here. The page posts the dependency-free
//   wasm module of crates/mk8-audio-worklet as bytes ({ cmd: 'init', wasm, rate, cache }); every
//   render quantum then pulls its 128 frames straight from the mixer, so a late animation frame
//   (course loading, WebRTC encode / decode, camera frames) can no longer starve the output.
//   The page sends command batches ({ cmds: Uint8Array }, mk8_audio::cmd::encode), sound files
//   ({ cmd: 'file', path: Uint8Array (UTF-8), bytes }) and unloads ({ cmd: 'unload', path }).
//   They are applied in arrival order; a file is copied into the wasm memory at most CHUNK bytes
//   per quantum so a 41 MB bank never blocks the audio thread (commands behind it wait).
//   Input 0 is the voice chat bus: the mixer limits it, ducks the game while somebody speaks and
//   limits the sum (mk8-audio `render_with_chat`); { cmd: 'chat', volume } sets its level.
// * push (fallback: no worklet wasm, or an older game wasm): the page renders on the main thread
//   and posts planar blocks ({ pcm: Float32Array(2 * frames) [left.., right..], frames }); they
//   play behind a small jitter buffer (`prebuffer` frames before starting, and again after
//   running dry, so a late frame does not click). { cmd: 'reset' }, { cmd: 'config', prebuffer }.
//
// Messages out: { engine: 'ready', version } / { engine: 'error', message } after 'init' (or when
// the engine fails later: output is silence then), and every ~50 ms a report
// { played, received, buffered, underruns, rms, peak, playing, engine, voices, streams, started,
//   chatDuck, chatPeak, limiter, files, playErrors, loadErrors, inbox }
// (`received` = frames of all pushed blocks so far: the page subtracts it from what it posted to
// know what is still in flight; the engine fields come from the mixer's counters).
//
// This file is both the worklet module (served build: addModule('audio-worklet.js')) and an ES
// module the page imports for WORKLET_SOURCE, its inline copy added from a Blob / data: URL
// (the fallback when the file fails to load). Keep the processor inside `workletMain`; a
// worklet scope has no fetch / TextDecoder / document, hence bytes everywhere.

function workletMain() {
  const CHUNK = 1 << 20; // file bytes copied into the wasm memory per render quantum
  const VERSION = 1; // crates/mk8-audio-worklet `mk8_version`

  class Mk8AudioProcessor extends AudioWorkletProcessor {
    constructor() {
      super();
      // push mode
      this.queue = []; // [{ pcm, frames, at }]
      this.buffered = 0;
      this.prebuffer = Math.round(sampleRate * 0.05);
      this.playing = false;
      this.received = 0;
      // engine mode
      this.ex = null; // wasm exports
      this.engine = false;
      this.inbox = []; // files / command batches, applied in order
      this.job = null; // file copy in progress: { ptr, done }
      this.loadErrors = 0;
      this.playErrors = 0;
      // meters / counters
      this.underruns = 0;
      this.played = 0;
      this.sum2 = 0;
      this.n = 0;
      this.peak = 0;
      this.sinceReport = 0;
      this.port.onmessage = (e) => this.onMessage(e.data);
    }

    onMessage(m) {
      if (!m) return;
      if (m.pcm) {
        this.queue.push({ pcm: m.pcm, frames: m.frames, at: 0 });
        this.buffered += m.frames;
        this.received += m.frames;
        // Never let the queue grow unbounded (main thread far ahead): drop the oldest.
        while (this.buffered > sampleRate && this.queue.length > 1) {
          const d = this.queue.shift();
          this.buffered -= d.frames - d.at;
        }
        return;
      }
      switch (m.cmd) {
        case 'init': this.initEngine(m.wasm, m.rate, m.cache); break;
        case 'reset': this.queue = []; this.buffered = 0; this.playing = false; this.received = 0; break;
        case 'config': if (m.prebuffer > 0) this.prebuffer = Math.round(m.prebuffer); break;
        case 'chat': if (this.ex) this.ex.mk8_set_chat_volume(Math.max(0, Math.min(1, Number(m.volume) || 0))); break;
        case 'file': case 'unload': this.inbox.push(m); break;
        default: if (m.cmds) this.inbox.push(m);
      }
    }

    initEngine(bytes, rate, cache) {
      WebAssembly.instantiate(bytes, {}).then(({ instance }) => {
        const ex = instance.exports;
        if (typeof ex.mk8_render !== 'function' || typeof ex.mk8_version !== 'function' || ex.mk8_version() !== VERSION) {
          throw new Error(`unexpected mk8_audio_worklet module (version ${typeof ex.mk8_version === 'function' ? ex.mk8_version() : '?'})`);
        }
        ex.mk8_engine_new(rate > 0 ? rate : sampleRate, cache > 0 ? cache : 0);
        this.ex = ex;
        this.engine = true;
        this.port.postMessage({ engine: 'ready', version: VERSION });
      }).catch((e) => {
        this.port.postMessage({ engine: 'error', message: String(e && e.message ? e.message : e) });
      });
    }

    /** Copies `bytes` into a fresh wasm buffer (ownership passes with the next call). */
    put(bytes) {
      if (!bytes.length) return 0;
      const p = this.ex.mk8_alloc(bytes.length);
      if (!p) throw new Error('mk8_alloc failed');
      new Uint8Array(this.ex.memory.buffer, p, bytes.length).set(bytes);
      return p;
    }

    /** Applies the inbox in order; one file copy may span several quanta. */
    pump() {
      const ex = this.ex;
      let budget = CHUNK;
      while (this.inbox.length && budget > 0) {
        const m = this.inbox[0];
        if (m.cmds) {
          const rc = ex.mk8_apply(this.put(m.cmds), m.cmds.length);
          if (rc > 0) this.playErrors += rc; else if (rc < 0) this.loadErrors++;
          this.inbox.shift();
        } else if (m.cmd === 'unload') {
          ex.mk8_unload_file(this.put(m.path), m.path.length);
          this.inbox.shift();
        } else if (m.cmd === 'file') {
          const bytes = m.bytes;
          if (!this.job) {
            const ptr = bytes.length ? ex.mk8_alloc(bytes.length) : 0;
            if (bytes.length && !ptr) { this.loadErrors++; this.inbox.shift(); continue; }
            this.job = { ptr, done: 0 };
          }
          const n = Math.min(budget, bytes.length - this.job.done);
          if (n > 0) {
            new Uint8Array(ex.memory.buffer, this.job.ptr + this.job.done, n).set(bytes.subarray(this.job.done, this.job.done + n));
            this.job.done += n;
            budget -= n;
          }
          if (this.job.done >= bytes.length) {
            if (ex.mk8_load_file(this.put(m.path), m.path.length, this.job.ptr, bytes.length) !== 0) this.loadErrors++;
            this.job = null;
            this.inbox.shift();
          }
        } else {
          this.inbox.shift();
        }
      }
    }

    meter(l, r, n) {
      for (let k = 0; k < n; k++) {
        const a = l[k]; const b = r ? r[k] : a;
        this.sum2 += a * a + b * b;
        const p = Math.max(Math.abs(a), Math.abs(b));
        if (p > this.peak) this.peak = p;
      }
      this.n += 2 * n;
    }

    process(inputs, outputs) {
      const out = outputs[0];
      const l = out[0];
      const r = out.length > 1 ? out[1] : null;
      const n = l.length;
      let i = 0;
      if (this.engine) {
        try {
          this.pump();
          const ex = this.ex;
          const cp = ex.mk8_chat_ptr(n);
          const inp = inputs[0];
          if (cp && inp && inp.length) {
            const chat = new Float32Array(ex.memory.buffer, cp, 2 * n);
            chat.set(inp[0], 0);
            chat.set(inp.length > 1 ? inp[1] : inp[0], n);
          }
          const p = ex.mk8_render(n);
          if (!p) throw new Error('mk8_render: no engine');
          const pcm = new Float32Array(ex.memory.buffer, p, 2 * n);
          l.set(pcm.subarray(0, n));
          if (r) r.set(pcm.subarray(n, 2 * n));
          this.meter(l, r, n);
          this.played += n;
          i = n;
        } catch (e) {
          this.engine = false;
          this.ex = null;
          this.port.postMessage({ engine: 'error', message: String(e && e.message ? e.message : e) });
        }
      } else {
        if (!this.playing && this.buffered >= this.prebuffer) this.playing = true;
        if (this.playing) {
          while (i < n && this.queue.length) {
            const c = this.queue[0];
            const take = Math.min(n - i, c.frames - c.at);
            const L = c.pcm.subarray(c.at, c.at + take);
            const R = c.pcm.subarray(c.frames + c.at, c.frames + c.at + take);
            l.set(L, i);
            if (r) r.set(R, i);
            this.meter(L, R, take);
            c.at += take; i += take; this.buffered -= take; this.played += take;
            if (c.at >= c.frames) this.queue.shift();
          }
          if (i < n) {
            // Ran dry: count it, wait for the jitter buffer to refill.
            this.underruns++;
            this.playing = false;
          }
        }
      }
      for (; i < n; i++) { l[i] = 0; if (r) r[i] = 0; }
      this.sinceReport += n;
      if (this.sinceReport >= sampleRate * 0.05) {
        this.sinceReport = 0;
        const rms = this.n ? Math.sqrt(this.sum2 / this.n) : 0;
        const rep = { played: this.played, received: this.received, buffered: this.buffered, underruns: this.underruns, rms, peak: this.peak, playing: this.engine || this.playing, engine: this.engine, loadErrors: this.loadErrors, playErrors: this.playErrors, inbox: this.inbox.length };
        if (this.engine) {
          const s = (k) => this.ex.mk8_stat(k);
          rep.voices = s(0); rep.streams = s(1); rep.started = s(2); rep.limiter = s(7); rep.chatDuck = s(8); rep.chatPeak = s(9); rep.files = s(11);
        }
        this.port.postMessage(rep);
        this.sum2 = 0; this.n = 0; this.peak = 0;
      }
      return true;
    }
  }
  registerProcessor('mk8-audio', Mk8AudioProcessor);
}

if (typeof registerProcessor === 'function' && typeof AudioWorkletProcessor === 'function') workletMain();

/** Source of the worklet for a Blob / data: URL fallback. */
export const WORKLET_SOURCE = `(${workletMain.toString()})();\n`;
// Game audio, main-thread side (docs/AUDIO.md ¬ß5). One AudioContext (latencyHint 'interactive',
// a fixed 48 kHz like the mixer: the browser resamples to the device, and the voice chat's
// WebRTC tracks join the same context), created at boot and resumed on the first user gesture
// (autoplay policy). Three output modes, best first:
// * 'engine': the mk8-audio mixer runs inside the AudioWorklet (www/audio-worklet.js +
//   pkg/mk8_audio_worklet.wasm, crates/mk8-audio-worklet; the served build takes its
//   content-hashed name from pkg/manifest.json, www/pkg-manifest.js). Every frame `tick()` posts the
//   frame's commands (app.audio_take_wire) and the sound files (app.audio_next_file*) to it; the
//   audio thread renders 128-frame quanta itself, so main-thread hitches (course loading, WebRTC
//   encode / decode of the voice chat, camera frames) cannot starve the output. Voice chat goes
//   into the worklet node's input: the mixer limits it, ducks the game by 3 dB while someone
//   speaks and limits the sum (never clips at the device). Needs a wasm with the remote exports;
//   older builds fall back to:
// * 'worklet': the wasm App renders on the main thread every animation frame, ~100 ms queued in
//   the worklet behind a jitter buffer (planar blocks over the MessagePort; no
//   SharedArrayBuffer, so plain HTTP and file:// work);
// * 'buffer': without AudioWorklet, AudioBufferSourceNodes scheduled ~100 ms ahead.
// In the last two the voice chat gets a WebAudio chat path (DynamicsCompressor limiter -> chat
// volume) summed with the game under a transparent safety compressor, and the game output is
// ducked while voice.js reports a speaking player.
//
// Sound files are optional and read lazily through the page's romfs source (app.audio_wanted);
// a missing file is silence. Settings (Music / SFX / Voice volume, mute) are stored in
// localStorage 'mk8.audio'. Voice chat attaches with `chat()` (see voice.attachAudio).
// Debug: window.__mk8Audio = { mode ('engine' | 'worklet' | 'buffer' | 'off'), state
// (AudioContext), sampleRate, voices, streams, started, active, rms / peak (output, last
// ~50 ms), underruns, bufferedMs, files (sound files loaded), errors (play errors), renderMs
// (main-thread mixer ms per 1/60 s; 'worklet' / 'buffer' modes), race (a race director runs),
// chatDuck (game gain under voice chat, engine mode), chatPeak, limiter (lowest limiter gain),
// speaking (voice.js reports a speaking player), engineError }.
import { WORKLET_SOURCE } from './audio-worklet.js';
import { pkgUrl } from './pkg-manifest.js';

const SAVE = 'mk8.audio';
const RATE = 48_000; // mixer / context rate (the browser resamples to the device)
const TARGET_S = 0.1; // jitter buffer kept queued (push modes)
const MAX_BLOCK_S = 0.15; // most rendered in one tick (after a hitch)
const QUANTUM = 128;
const DUCK_GAIN = 0.708; // -3 dB on the game while a voice chat player speaks (push modes)
const ENGINE_CACHE = 64 << 20; // decoded-wave cache of the worklet's mixer (bytes)

export const DEFAULT_SETTINGS = { music: 0.8, sfx: 0.8, voice: 0.8, mute: false };

export function loadSettings() {
  try {
    const s = JSON.parse(localStorage.getItem(SAVE) || '{}');
    const num = (v, d) => (typeof v === 'number' && Number.isFinite(v) ? Math.max(0, Math.min(1, v)) : d);
    return { music: num(s.music, DEFAULT_SETTINGS.music), sfx: num(s.sfx, DEFAULT_SETTINGS.sfx), voice: num(s.voice, DEFAULT_SETTINGS.voice), mute: s.mute === true };
  } catch { return { ...DEFAULT_SETTINGS }; }
}

export function saveSettings(s) {
  try { localStorage.setItem(SAVE, JSON.stringify(s)); } catch { /* private mode / blocked storage */ }
}

/** A no-op controller (old wasm without the audio exports, or no WebAudio). */
const NONE = { tick() {}, ui() {}, settings: () => loadSettings(), setSettings() {}, available: false, chat: () => null };

/**
 * @param app the wasm App
 * @param getSource () => romfs source ({ read(path) -> Promise<Uint8Array|null> }) or null
 */
export function initAudio(app, getSource) {
  const debug = { mode: 'off', state: 'none', sampleRate: 0, voices: 0, streams: 0, started: 0, active: false, rms: 0, peak: 0, underruns: 0, bufferedMs: 0, files: 0, errors: 0, chatDuck: 1, chatPeak: 0, limiter: 1, speaking: false, engineError: null };
  window.__mk8Audio = debug;
  if (typeof app.audio_init !== 'function' || typeof app.audio_render !== 'function') return NONE;
  const Ctx = window.AudioContext || window.webkitAudioContext;
  if (!Ctx) return NONE;
  let ctx;
  try { ctx = new Ctx({ latencyHint: 'interactive', sampleRate: RATE }); } catch {
    try { ctx = new Ctx({ latencyHint: 'interactive' }); } catch (e) { console.warn('audio: no AudioContext', e); return NONE; }
  }
  const rate = ctx.sampleRate;
  debug.sampleRate = rate;
  // The mixer in the worklet needs the wasm's remote exports (feature-detected: an older live
  // wasm keeps the main-thread mixer).
  const remoteCapable = ['audio_init_remote', 'audio_take_wire', 'audio_next_file', 'audio_next_file_bytes'].every((f) => typeof app[f] === 'function');
  let settings = loadSettings();
  app.audio_settings(settings.music, settings.sfx, settings.voice, settings.mute);

  // ---- graph ----
  // game: out -> (master) -> destination.  chat (voice.js bus): chatIn -> worklet input (engine)
  // or chatIn -> chatLim -> chatVol -> master (push modes).
  const out = ctx.createGain();
  const chatIn = ctx.createGain();
  let chatVolume = 0.8;
  let speaking = false;
  let node = null; // AudioWorkletNode
  let mode = 'pending';
  let written = 0; // push: frames posted to the worklet
  // Last worklet report: frames received, frames queued there, whether it plays, ctx time.
  let rep = { received: 0, buffered: 0, playing: false, at: 0 };
  let nextTime = 0; // buffer fallback: when the next block starts
  const encoder = typeof TextEncoder === 'function' ? new TextEncoder() : null;

  function onReport(m) {
    rep = { received: m.received, buffered: m.buffered, playing: m.playing, at: ctx.currentTime };
    debug.underruns = m.underruns; debug.rms = m.rms; debug.peak = m.peak;
    debug.bufferedMs = Math.round((m.buffered / rate) * 1000);
    if (m.engine) {
      debug.voices = m.voices; debug.streams = m.streams; debug.started = m.started;
      debug.chatDuck = m.chatDuck; debug.chatPeak = m.chatPeak; debug.limiter = m.limiter;
      debug.workletFiles = m.files; debug.workletErrors = m.playErrors + m.loadErrors; debug.inbox = m.inbox;
    }
  }

  /** Push modes: the voice chat path in WebAudio and a transparent safety compressor on the sum. */
  function routeChatJs() {
    const master = ctx.createDynamicsCompressor();
    master.threshold.value = 0; master.knee.value = 0; master.ratio.value = 20; master.attack.value = 0.001; master.release.value = 0.1;
    const lim = ctx.createDynamicsCompressor();
    lim.threshold.value = -10; lim.knee.value = 0; lim.ratio.value = 20; lim.attack.value = 0.003; lim.release.value = 0.15;
    const vol = ctx.createGain();
    vol.gain.value = chatVolume;
    chatIn.connect(lim); lim.connect(vol); vol.connect(master);
    out.connect(master); master.connect(ctx.destination);
    chatVolNode = vol;
    applyDuck();
  }
  let chatVolNode = null;
  function applyDuck() {
    if (mode === 'engine') return; // the mixer ducks from the chat signal itself
    const t = ctx.currentTime;
    out.gain.setTargetAtTime(speaking ? DUCK_GAIN : 1, t, speaking ? 0.02 : 0.2);
  }

  async function addWorkletModule() {
    if (!ctx.audioWorklet || typeof AudioWorkletNode !== 'function') throw new Error('no AudioWorklet');
    let url = null;
    try { url = new URL('./audio-worklet.js', import.meta.url).href; } catch { url = null; }
    // Inline copy: a Blob URL, or (file://, where Chrome refuses blob: worklet modules from the
    // page's opaque origin) a data: URL.
    const fromBlob = async () => {
      const blobUrl = URL.createObjectURL(new Blob([WORKLET_SOURCE], { type: 'text/javascript' }));
      try { await ctx.audioWorklet.addModule(blobUrl); } finally { URL.revokeObjectURL(blobUrl); }
    };
    const fromData = () => ctx.audioWorklet.addModule(`data:text/javascript;charset=utf-8,${encodeURIComponent(WORKLET_SOURCE)}`);
    if (url) {
      try { await ctx.audioWorklet.addModule(url); } catch (e) { console.warn('audio worklet file failed, using the inline copy', e); await fromBlob(); }
    } else if (location.protocol === 'file:') {
      try { await fromData(); } catch { await fromBlob(); }
    } else {
      try { await fromBlob(); } catch { await fromData(); }
    }
  }

  /** Bytes of the worklet's wasm (next to the game's). */
  async function loadWorkletWasm() {
    const url = await pkgUrl('mk8_audio_worklet.wasm');
    const r = await fetch(url);
    if (!r.ok) throw new Error(`${url.pathname}: HTTP ${r.status}`);
    return new Uint8Array(await r.arrayBuffer());
  }

  /** Preferred: the mixer in the worklet. Throws (before touching the App) when unavailable. */
  async function setupEngine() {
    const wasm = await loadWorkletWasm();
    const n = new AudioWorkletNode(ctx, 'mk8-audio', { numberOfInputs: 1, numberOfOutputs: 1, outputChannelCount: [2] });
    const ready = new Promise((resolve, reject) => {
      const timer = setTimeout(() => reject(new Error('worklet engine init timed out')), 8000);
      n.port.onmessage = (e) => {
        const m = e.data;
        if (!m || !m.engine || typeof m.engine !== 'string') return;
        clearTimeout(timer);
        if (m.engine === 'ready') resolve(m); else reject(new Error(m.message || 'worklet engine failed'));
      };
    });
    n.port.postMessage({ cmd: 'init', wasm, rate, cache: ENGINE_CACHE }, [wasm.buffer]);
    try { await ready; } catch (e) { try { n.disconnect(); } catch { /* not connected */ } throw e; }
    node = n;
    node.port.onmessage = (e) => {
      const m = e.data;
      if (m && m.engine === 'error') {
        // The mixer trapped: silence until a reload (its files are gone with it).
        debug.engineError = m.message; console.error('audio: worklet engine failed:', m.message);
        return;
      }
      if (m && typeof m.engine === 'string') return;
      onReport(m);
    };
    chatIn.connect(node, 0, 0);
    node.connect(out);
    out.connect(ctx.destination);
    node.port.postMessage({ cmd: 'chat', volume: chatVolume });
    app.audio_init_remote(rate);
    mode = 'engine';
  }

  /** Fallback: the App renders on the main thread, the worklet plays the blocks. */
  function setupPush() {
    node = new AudioWorkletNode(ctx, 'mk8-audio', { numberOfInputs: 0, numberOfOutputs: 1, outputChannelCount: [2] });
    node.port.postMessage({ cmd: 'config', prebuffer: Math.round(rate * 0.06) });
    node.port.onmessage = (e) => { if (e.data && typeof e.data.engine !== 'string') onReport(e.data); };
    node.connect(out);
    routeChatJs();
    app.audio_init(rate);
    mode = 'worklet';
  }

  (async () => {
    try {
      await addWorkletModule();
    } catch (e) {
      console.warn('audio: AudioWorklet unavailable, using buffer scheduling:', e && e.message ? e.message : e);
      routeChatJs();
      app.audio_init(rate);
      mode = 'buffer';
      return;
    }
    if (remoteCapable) {
      try { await setupEngine(); return; } catch (e) { console.warn('audio: mixer in the worklet unavailable, rendering on the main thread:', e && e.message ? e.message : e); }
    }
    setupPush();
  })();

  // ---- autoplay: resume on the first gesture ----
  // touchstart / touchend count on iOS (a tap on the on-screen controls is the first gesture
  // there); an 'interrupted' context (phone call, another app's audio) resumes the same way.
  let hiddenSuspended = false; // suspended by us because the tab is hidden
  const resume = () => { if (ctx.state !== 'running' && !hiddenSuspended) ctx.resume().catch(() => {}); };
  for (const ev of ['pointerdown', 'pointerup', 'keydown', 'touchstart', 'touchend', 'mousedown', 'click']) window.addEventListener(ev, resume, { capture: true, passive: true });
  ctx.addEventListener('statechange', () => { debug.state = ctx.state; });
  debug.state = ctx.state;
  // ---- hidden tab: silence (the worklet keeps rendering otherwise), back on return ----
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      if (ctx.state === 'running') { hiddenSuspended = true; ctx.suspend().catch(() => { hiddenSuspended = false; }); }
    } else if (hiddenSuspended) {
      hiddenSuspended = false;
      // May be refused until the next gesture (iOS): the gesture handlers above retry.
      ctx.resume().catch(() => {});
    }
  });
  window.addEventListener('pagehide', () => { if (ctx.state === 'running') { hiddenSuspended = true; ctx.suspend().catch(() => { hiddenSuspended = false; }); } });
  window.addEventListener('pageshow', () => { if (hiddenSuspended) { hiddenSuspended = false; ctx.resume().catch(() => {}); } });

  // ---- lazy sound files ----
  let loading = 0;
  async function pumpFiles() {
    const src = getSource();
    if (!src || loading > 0) return;
    const want = Array.from(app.audio_wanted());
    if (want.length === 0) return;
    loading = want.length;
    let next = 0;
    const worker = async () => {
      while (next < want.length) {
        const p = want[next++];
        let bytes = null;
        try { bytes = await src.read(p); } catch { bytes = null; }
        if (bytes) { try { app.add_file(p, bytes); } catch (e) { console.warn('audio file', p, e); } }
        loading--;
      }
    };
    await Promise.all(Array.from({ length: 3 }, worker));
    loading = 0;
  }

  let active = false;
  let ticks = 0;
  let underrunsBuffer = 0;
  let renderMs = 0;
  function render(frames) {
    const t0 = performance.now();
    const pcm = app.audio_render(frames);
    // Mixer cost per rendered 1/60 s (exponential average), for the debug counters.
    renderMs += ((performance.now() - t0) * (rate / 60 / frames) - renderMs) * 0.05;
    debug.renderMs = Math.round(renderMs * 1000) / 1000;
    return pcm instanceof Float32Array ? pcm : new Float32Array(pcm);
  }

  /** Engine mode: forward the frame's sound files (first: commands may refer to them) and commands. */
  function forward() {
    let path;
    let guard = 0;
    while (guard++ < 64 && (path = app.audio_next_file()) != null) {
      const bytes = app.audio_next_file_bytes();
      const pb = encoder ? encoder.encode(path) : Uint8Array.from(path, (c) => c.charCodeAt(0) & 0x7f);
      if (bytes) node.port.postMessage({ cmd: 'file', path: pb, bytes }, [bytes.buffer]);
      else node.port.postMessage({ cmd: 'unload', path: pb });
    }
    const wire = app.audio_take_wire();
    if (wire && wire.length) node.port.postMessage({ cmds: wire }, [wire.buffer]);
  }

  function tick() {
    ticks++;
    if ((ticks & 7) === 0) pumpFiles();
    const running = ctx.state === 'running' && (mode === 'engine' || mode === 'worklet' || mode === 'buffer');
    if (running !== active) {
      active = running;
      app.audio_set_active(running);
      if (running && mode !== 'engine') {
        nextTime = 0;
        if (node) node.port.postMessage({ cmd: 'reset' });
        written = 0; rep = { received: 0, buffered: 0, playing: false, at: ctx.currentTime };
      }
    }
    debug.mode = mode; debug.active = active;
    if (mode === 'engine') forward(); // files / commands flow whatever the context state
    if (!active) return;
    const now = ctx.currentTime;
    if (mode === 'engine') {
      // Nothing to render here: the worklet pulls the mixer itself.
    } else if (mode === 'worklet') {
      // Frames queued in the worklet: its last report, plus blocks still in flight, minus what
      // it played since the report.
      const drained = rep.playing ? Math.max(0, now - rep.at) * rate : 0;
      const buffered = Math.max(0, rep.buffered - drained) + Math.max(0, written - rep.received);
      const need = TARGET_S * rate - buffered;
      if (need > 0) {
        const frames = Math.min(Math.ceil(need / QUANTUM) * QUANTUM, Math.round(MAX_BLOCK_S * rate / QUANTUM) * QUANTUM);
        const pcm = render(frames);
        node.port.postMessage({ pcm, frames }, [pcm.buffer]);
        written += frames;
      }
    } else {
      // Fallback: AudioBufferSourceNodes scheduled back to back ~TARGET_S ahead.
      if (nextTime < now) { if (nextTime > 0) underrunsBuffer++; nextTime = now + 0.02; }
      const lead = nextTime - now;
      if (lead < TARGET_S) {
        const frames = Math.min(Math.ceil(((TARGET_S - lead) * rate) / QUANTUM) * QUANTUM, Math.round(MAX_BLOCK_S * rate));
        const pcm = render(frames);
        const buf = ctx.createBuffer(2, frames, rate);
        buf.copyToChannel(pcm.subarray(0, frames), 0);
        buf.copyToChannel(pcm.subarray(frames, 2 * frames), 1);
        const s = ctx.createBufferSource();
        s.buffer = buf; s.connect(out); s.start(nextTime);
        nextTime += frames / rate;
        let sum = 0; for (let i = 0; i < pcm.length; i++) sum += pcm[i] * pcm[i];
        debug.rms = Math.sqrt(sum / Math.max(1, pcm.length));
      }
      debug.underruns = underrunsBuffer;
      debug.bufferedMs = Math.round((nextTime - now) * 1000);
    }
    if ((ticks & 15) === 0 && typeof app.audio_stats === 'function') {
      const st = app.audio_stats();
      if (mode !== 'engine') { debug.voices = st[0]; debug.streams = st[1]; debug.started = st[2]; debug.mixRms = st[4]; }
      debug.files = st[7]; debug.errors = st[8]; debug.race = st[9] === 1;
    }
  }

  return {
    available: true,
    tick,
    /** Homemade-menu sound by SLink key. */
    ui(key) { if (active && typeof app.audio_ui === 'function') app.audio_ui(key); },
    settings: () => ({ ...settings }),
    setSettings(s) {
      settings = { ...settings, ...s };
      app.audio_settings(settings.music, settings.sfx, settings.voice, settings.mute);
      saveSettings(settings);
    },
    context: ctx,
    /** Voice chat hook for voice.attachAudio: play the voices in this context into `destination`
     *  (the chat path: limiter, chat volume, game ducking, final limiter), report speakers. */
    chat() {
      return {
        context: ctx,
        destination: chatIn,
        setVolume(v) {
          chatVolume = Math.max(0, Math.min(1, Number(v) || 0));
          if (mode === 'engine' && node) node.port.postMessage({ cmd: 'chat', volume: chatVolume });
          if (chatVolNode) chatVolNode.gain.setTargetAtTime(chatVolume, ctx.currentTime, 0.05);
        },
        onSpeaking(n) {
          speaking = n > 0;
          debug.speaking = speaking;
          applyDuck();
        },
      };
    },
  };
}
// Real game art for the page's own menu (www/menu.css draws a CSS-only stand-in until this runs).
//
// Once the romfs is loaded, wasm decodes a few of the game's UI textures on request
// (`App.ui_image(name, package)`, crates/mk8-web/src/brand.rs: `[w][h][RGBA top-down]`) and
// this module paints them into the menu's canvases: the title logo, the Toad icons of the two
// big choices, the class shields, the checker / monogram masks behind everything, and the
// title backgrounds + character art of `UI/cmn/menu_title`. Nothing is stored or downloaded:
// the art comes from the user's own files, in their browser, every time. Feature-detected:
// an older wasm without `ui_image` simply keeps the CSS look.
//
// Work is spread over animation frames (one texture each) so the menu never stutters; the two
// 1920x1080 backgrounds come last and fade in when ready.

const $ = (id) => document.getElementById(id);
let app = null;
const queue = [];
let running = false;
let started = false;
let onlineLoaded = false;

/** True when this wasm can hand out game textures. */
export const available = () => !!app && typeof app.ui_image === 'function';

export function initBrand(theApp) {
  app = theApp;
}

/** Decode one texture: ImageData or null. */
function image(name, pkg = '') {
  if (!available()) return null;
  try {
    const b = app.ui_image(name, pkg);
    if (!b || b.length < 8) return null;
    const dv = new DataView(b.buffer, b.byteOffset, 8);
    const w = dv.getUint32(0, true); const h = dv.getUint32(4, true);
    if (!w || !h || b.length < 8 + w * h * 4) return null;
    return new ImageData(new Uint8ClampedArray(b.buffer, b.byteOffset + 8, w * h * 4), w, h);
  } catch (e) {
    console.warn('brand: texture', name, e);
    return null;
  }
}

function paint(canvas, img) {
  canvas.width = img.width; canvas.height = img.height;
  canvas.getContext('2d').putImageData(img, 0, 0);
  canvas.hidden = false;
  canvas.classList.add('ready');
}

/** Single-channel textures (`...^s`) carry their shape in alpha: white with that alpha. */
function maskUrl(img) {
  const d = img.data;
  for (let i = 0; i < d.length; i += 4) { d[i] = 255; d[i + 1] = 255; d[i + 2] = 255; }
  const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
  c.getContext('2d').putImageData(img, 0, 0);
  return `url("${c.toDataURL('image/png')}")`;
}

function step() {
  const job = queue.shift();
  if (!job) { running = false; return; }
  try { job(); } catch (e) { console.warn('brand', e); }
  requestAnimationFrame(step);
}
function enqueue(job) {
  queue.push(job);
  if (!running) { running = true; requestAnimationFrame(step); }
}

/** The menu is up: paint the logo, icons and backgrounds (once). */
export function brandStart() {
  if (started || !available()) return;
  started = true;
  // Logo (mn_TitleScene_00 / TitleLogoDX_00^l).
  enqueue(() => {
    const img = image('TitleLogoDX_00^l', 'mn_TitleScene_00');
    if (!img) return;
    paint($('brand-logo'), img);
    $('logo-css').hidden = true;
  });
  // Icons: every <canvas data-tex data-pkg> replaces its CSS / SVG stand-in.
  for (const c of document.querySelectorAll('#home canvas[data-tex]')) {
    enqueue(() => {
      const img = image(c.dataset.tex, c.dataset.pkg || '');
      if (!img) return;
      paint(c, img);
      for (const sib of c.parentElement.children) if (sib !== c) sib.hidden = true;
    });
  }
  // Masks behind everything: the checker tile and the MARIO KART monogram.
  enqueue(() => {
    const img = image('tc_MtCheck_64x64^s', 'mn_Background_00');
    if (!img) return;
    document.documentElement.style.setProperty('--check-url', maskUrl(img));
    for (const el of document.querySelectorAll('.mk-bg .check')) el.classList.add('real');
  });
  enqueue(() => {
    const img = image('ym_ModeMonogramGp_00^s', 'mn_Background_00');
    if (img) document.documentElement.style.setProperty('--mono-url', maskUrl(img));
  });
  // The Single Player title background and Mario (loose textures of UI/cmn/menu_title).
  enqueue(() => { const img = image('TitleBGSingle_00^u'); if (img) paint($('bg-single'), img); });
  enqueue(() => { const img = image('MnSingle_Mario^l'); if (img) paint($('hero-single'), img); });
  if (onlineLoaded) { onlineLoaded = false; brandOnline(); }
}

/** The online pages are shown: their background + art, once. */
export function brandOnline() {
  if (onlineLoaded) return;
  onlineLoaded = true;
  if (!started) return; // brandStart loads them afterwards
  if (!available()) return;
  enqueue(() => { const img = image('TitleBGMulti_00^u'); if (img) paint($('bg-online'), img); });
  enqueue(() => { const img = image('MnMulti_Mario^l'); if (img) paint($('hero-online'), img); });
}

/** For tests: which canvases got real art. */
export function paintedCount() {
  return document.querySelectorAll('#home canvas.ready').length;
}
{"connections":10,"max_players":100,"protocol":5,"rooms":4,"status":"ok","uptime_s":136126,"version":"0.1.0"}
// The page's own front menu (styled after the game's menus, see docs/DECISIONS.md and
// www/menu.css): SINGLEPLAYER -> class -> the game's own character / kart / cup screens
// (mk8-ui); ONLINE -> rooms (www/net.js); an Options drawer with the face photo, live camera
// and sound settings. Shown whenever the game UI is back on a page this menu replaces
// (app.at_home()). Keyboard (arrows, Enter, Esc / Backspace) and gamepad (d-pad / stick, A, B)
// move a visible focus ring over the controls; real game art is painted in by www/brand.js.
import * as net from './net.js';
import * as live from './live.js';
import * as voice from './voice.js';
import * as brand from './brand.js';

const $ = (id) => document.getElementById(id);

let onFaceJpeg = () => {};

export function initHome(app, audio = null) {
  const home = $('home');
  initSound(audio);
  brand.initBrand(app);
  let room = null;
  // The largest "Racers" value: the room server's cap (--max-players, learnt on Welcome and
  // shown in every room snapshot), 100 offline.
  let serverCap = 0;
  const cap = () => serverCap || (room && room.max_players) || Number(window.MK8_MAX_PLAYERS) || 100;

  const show = (page) => {
    for (const p of document.querySelectorAll('#home .page')) p.classList.toggle('on', p.id === `pg-${page}`);
    home.dataset.page = page;
    if (page === 'online' || page === 'room') { try { brand.brandOnline(); } catch (e) { console.warn('brand art:', e); } }
    const scroll = $('home-scroll');
    if (scroll) scroll.scrollTop = 0;
    // First control of the page, the big choice first (a selector list would return the first in
    // document order).
    for (const sel of ['button.big:not([hidden]):not(:disabled)', 'input[type=text]', 'button:not([hidden]):not(:disabled)', 'select']) {
      const first = [...document.querySelectorAll(`#pg-${page} ${sel}`)].find((el) => el.offsetParent !== null && !el.closest('[hidden]'));
      if (first) { first.focus({ preventScroll: true }); break; }
    }
  };
  for (const b of document.querySelectorAll('#home [data-go]')) b.addEventListener('click', () => show(b.dataset.go));

  // ---- singleplayer ----
  // "Racers": karts in the race (2..=cap, the game's 12 by default). Needs a build with
  // App.set_grid_size (feature-detected; older builds race 12). The cap is the room server's
  // (--max-players, learnt on Welcome) or 100 offline.
  injectRacerStyles();
  const RACERS_SAVE = 'mk8.racers';
  const singleRacers = racersSelect('single-racers', () => cap());
  singleRacers.value = String(savedRacers());
  const hasGrid = typeof app.set_grid_size === 'function' || typeof app.set_racer_count === 'function';
  const setGridSize = (n) => { if (typeof app.set_grid_size === 'function') app.set_grid_size(n); else if (typeof app.set_racer_count === 'function') app.set_racer_count(n); };
  const classNote = document.querySelector('#pg-class .note');
  if (classNote) {
    const row = document.createElement('div'); row.className = 'row racers-row';
    const label = document.createElement('label'); label.htmlFor = 'single-racers'; label.textContent = 'Racers';
    const note = document.createElement('span'); note.className = 'note'; note.id = 'single-racers-note';
    row.append(label, singleRacers, note);
    classNote.before(row);
    row.hidden = !hasGrid;
    const refresh = () => { const n = Number(singleRacers.value); note.textContent = n === 12 ? 'the game\'s grid: you + 11 CPUs' : `you + ${n - 1} CPUs${n > 12 ? ' (big race: extra grid rows, more work for your machine)' : ''}`; };
    singleRacers.addEventListener('change', () => { try { localStorage.setItem(RACERS_SAVE, singleRacers.value); } catch { /* private mode */ } refresh(); });
    refresh();
  }
  function savedRacers() { try { const n = Number(localStorage.getItem(RACERS_SAVE)); return n >= 2 && n <= 255 ? n : 12; } catch { return 12; } }
  $('btn-single').addEventListener('click', () => { singleRacers.fill(); show('class'); });
  // "Unblocked version": the Google Sites page that embeds this game (for networks that block
  // this domain). Hidden when the page already runs inside an embed; opens in the top window.
  const UNBLOCKED_URL = 'https://sites.google.com/view/mariokart8online/';
  const embedded = (() => { try { return window.top !== window.self; } catch { return true; } })();
  $('btn-unblocked').hidden = embedded;
  $('btn-unblocked').addEventListener('click', () => { try { window.top.location.href = UNBLOCKED_URL; } catch { window.open(UNBLOCKED_URL, '_blank', 'noopener'); } });
  for (const b of document.querySelectorAll('#pg-class [data-cc]')) {
    b.addEventListener('click', () => {
      if (hasGrid) setGridSize(Number(singleRacers.value) || 12);
      app.start_singleplayer(Number(b.dataset.cc));
      hide();
    });
  }

  // ---- online (www/net.js, docs/NETWORK.md) ----
  // Flow: ONLINE -> name -> create a room (you host), join with a code or pick one from the
  // public room list (GET /rooms.json; rooms whose host ticked "public") -> the room page:
  // everybody picks driver / body / tires / glider with the dropdowns and presses "I'm ready";
  // the host picks course + class and starts. The game then loads the race (loading card,
  // intro, HUD, results) and every browser simulates it in lockstep; afterwards the room
  // page comes back. A photo face is sent to the room as a small JPEG.
  const SAVE = 'mk8.online';
  const saved = (() => { try { return JSON.parse(localStorage.getItem(SAVE) || '{}'); } catch { return {}; } })();
  const save = () => { try { localStorage.setItem(SAVE, JSON.stringify({ name: myName(), combo: myCombo() })); } catch { /* private mode */ } };
  const PARTS = ['driver', 'body', 'tire', 'glider'];
  for (const k of PARTS) {
    $(`room-${k}`).replaceChildren(...app.part_names(k).map((e) => {
      const at = e.indexOf(':');
      const o = document.createElement('option'); o.value = e.slice(0, at); o.textContent = e.slice(at + 1); return o;
    }));
  }
  const setCombo = (c) => PARTS.forEach((k, i) => { const el = $(`room-${k}`); if ([...el.options].some((o) => Number(o.value) === c[i])) el.value = String(c[i]); });
  const myCombo = () => PARTS.map((k) => Number($(`room-${k}`).value) || 0);
  const myName = () => ($('room-name').value || $('net-name').value || 'Player').trim().slice(0, 16) || 'Player';
  setCombo(Array.isArray(saved.combo) ? saved.combo : Array.from(app.local_combo()).slice(0, 4));
  $('net-name').value = $('room-name').value = saved.name || '';
  const profile = () => ({ name: myName(), combo: myCombo() });
  const err = (m) => { $('online-err').textContent = m || ''; $('room-err').textContent = m || ''; };
  const banner = (m) => { const b = $('net-banner'); b.textContent = m || ''; b.hidden = !m; };
  const netStatus = (text, state) => { const p = $('net-status'); p.textContent = text; p.classList.toggle('ok', state === 'ok'); p.classList.toggle('bad', state === 'bad'); };
  let ready = false;
  let raceId = null; // race this page is in / was in
  let doneRace = null; // last race this page finished or left (ignored if the server re-sends it)
  let finishedAt = null; // when the local kart crossed the line (race_done goes out a moment later)
  let sentDone = false; // race_done sent for `raceId`
  let afterRace = false; // the room page came back from a race (shown until the next ready / start)
  let desynced = false;

  $('btn-online').addEventListener('click', () => {
    err();
    try { show('online'); } catch (e) { console.error('online page:', e); }
    try { refreshRooms(); } catch (e) { console.warn('room list:', e); }
    try {
      net.connect(profile());
      netStatus(net.isConnected() ? 'connected' : 'connecting...', net.isConnected() ? 'ok' : '');
    } catch (e) {
      console.error('net connect:', e);
      netStatus(`cannot start networking: ${e && e.message ? e.message : e}`, 'bad');
      err(`Networking failed to start: ${e && e.message ? e.message : e}. Reload the page; if it persists, send this message.`);
    }
  });
  const nameSync = (src) => { $('net-name').value = $('room-name').value = src.value; };
  $('net-name').addEventListener('input', () => nameSync($('net-name')));
  $('room-name').addEventListener('input', () => nameSync($('room-name')));
  $('room-name').addEventListener('change', () => { save(); net.setProfile(profile()); });
  for (const k of PARTS) $(`room-${k}`).addEventListener('change', () => { save(); net.setProfile(profile()); });
  $('btn-create').addEventListener('click', () => {
    err(); save(); net.connect(profile());
    $('room-public').checked = $('create-public').checked;
    try { net.setProfile(profile()); net.createRoom(); } catch (e) { err(String(e.message || e)); }
  });
  const join = (code) => {
    err(); save(); net.connect(profile());
    try { net.setProfile(profile()); net.joinRoom(code); } catch (e) { err(String(e.message || e)); }
  };
  $('btn-join').addEventListener('click', () => join($('join-code').value));
  $('join-code').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('btn-join').click(); });
  $('btn-leave').addEventListener('click', () => { net.leaveRoom(); room = null; ready = false; afterRace = false; show('online'); refreshRooms(); });
  $('btn-copy').addEventListener('click', async () => {
    const code = room ? room.code : '';
    try { await navigator.clipboard.writeText(code); $('btn-copy').textContent = 'Copied!'; } catch {
      const r = document.createRange(); r.selectNodeContents($('room-code')); getSelection().removeAllRanges(); getSelection().addRange(r);
      $('btn-copy').textContent = 'press Ctrl+C';
    }
    setTimeout(() => { $('btn-copy').textContent = 'Copy code'; }, 1500);
  });
  $('btn-ready').addEventListener('click', () => { ready = !ready; afterRace = false; net.setReady(ready); renderRoom(); });
  const courses = app.course_list().map((e) => e.split('|'));
  const courseName = new Map(courses);
  $('room-course').replaceChildren(...courses.map(([dir, name]) => { const o = document.createElement('option'); o.value = dir; o.textContent = name; return o; }));
  if (courses.some(([d]) => d === 'Gu_FirstCircuit')) $('room-course').value = 'Gu_FirstCircuit';
  // Host's "Racers" (grid size) next to course / class; hidden when the build / server predates it.
  const roomRacers = racersSelect('room-racers', () => cap());
  {
    const cls = $('room-class');
    const label = document.createElement('label'); label.htmlFor = 'room-racers'; label.textContent = 'Racers';
    cls.after(label, roomRacers);
    label.hidden = roomRacers.hidden = true;
    roomRacers.dataset.label = 'room-racers-label'; label.id = 'room-racers-label';
  }
  const gridLive = () => !!(room && room.settings && room.settings.grid_size !== undefined);
  const gridSize = () => (gridLive() ? room.settings.grid_size : 12);
  const settings = () => ({
    ...(room ? room.settings : {}),
    course: $('room-course').value,
    engine_class: Number($('room-class').value),
    public: $('room-public').checked,
    rollback: true, // prediction + rollback is always on (lockstep stays available to tests only)
    ...(gridLive() ? { grid_size: Number(roomRacers.value) || gridSize() } : {}),
  });
  const pushSettings = () => { if (room && room.host === net.myId()) { try { net.setSettings(settings()); } catch (e) { err(String(e.message || e)); } } };
  $('room-course').addEventListener('change', pushSettings);
  $('room-class').addEventListener('change', pushSettings);
  roomRacers.addEventListener('change', pushSettings);
  $('room-public').addEventListener('change', pushSettings);
  $('btn-room-start').addEventListener('click', () => {
    if (!room) return;
    err();
    try { net.startRace(settings()); } catch (e) { err(String(e.message || e)); }
  });

  // Public room list: fetched on entering the Online page, then every 5 s while it is shown.
  const CC = ['50cc', '100cc', '150cc', '200cc'];
  let roomsBusy = false;
  async function refreshRooms() {
    if (roomsBusy) return;
    roomsBusy = true;
    try {
      const r = await fetch(net.httpUrl('/rooms.json'), { cache: 'no-store' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const { rooms } = await r.json();
      $('public-rooms').replaceChildren(...rooms.map((p) => {
        const li = document.createElement('li');
        const full = p.players >= p.max_players;
        const text = document.createElement('span');
        text.textContent = `${p.host_name}'s room - ${courseName.get(p.course) || p.course} ${CC[p.engine_class] || ''} - ${p.players}/${p.max_players}${p.phase === 'lobby' ? '' : ' - racing'}`;
        const b = document.createElement('button');
        b.className = 'small'; b.textContent = p.phase === 'lobby' ? 'Join' : 'Watch'; b.disabled = full;
        b.addEventListener('click', () => join(p.code));
        li.append(text, b);
        return li;
      }));
      $('public-rooms-note').textContent = rooms.length ? '' : 'No public rooms right now - create one and tick "List my room publicly".';
    } catch (e) {
      $('public-rooms-note').textContent = `Cannot load the room list: ${e.message || e}`;
    } finally { roomsBusy = false; }
  }
  $('btn-rooms-refresh').addEventListener('click', refreshRooms);
  setInterval(() => { if (shown && !document.hidden && $('pg-online').classList.contains('on')) refreshRooms(); }, 5000);

  const faceUrls = new Map(); // player -> object URL of the received photo
  const stillFaces = new Map(); // player -> decoded 256x256 RGBA of the photo (live camera fallback)
  // One card per player: face (photo or initial), name, driver, state tags; www/voice.js adds
  // its speaking dot and mute button.
  function renderRoom() {
    if (!room) return;
    const me = net.myId();
    const host = room.host === me;
    $('room-code').textContent = room.code.length === 6 ? `${room.code.slice(0, 3)}-${room.code.slice(3)}` : room.code;
    const grid = gridSize();
    const humans = room.players.filter((p) => p.connected).length;
    // Many players: compact cards (small face + name, state as a dot, scrollable grid).
    const compact = room.players.length > 12;
    const list = $('room-players');
    list.classList.toggle('compact', compact);
    list.replaceChildren(...room.players.map((p) => {
      const li = document.createElement('li');
      if (p.id === me) li.classList.add('me');
      const el = (cls, text) => { const d = document.createElement('div'); d.className = cls; if (text !== undefined) d.textContent = text; return d; };
      const face = el('pface');
      if (faceUrls.has(p.id)) { const img = document.createElement('img'); img.src = faceUrls.get(p.id); img.alt = ''; img.loading = 'lazy'; face.append(img); }
      else face.textContent = (p.name || '?').trim().charAt(0).toUpperCase() || '?';
      const tags = el('ptags');
      const tag = (text, cls) => { const t = document.createElement('span'); t.className = `tag ${cls || ''}`.trim(); t.textContent = text; return t; };
      const state = p.host ? 'host' : !p.connected ? 'off' : p.ready ? 'ok' : 'wait';
      if (compact) {
        li.classList.add(`st-${state}`);
        li.title = `${p.name} - ${app.driver_name(p.combo.driver, 0)} - ${p.host ? 'host' : p.ready ? 'ready' : 'not ready'}${p.connected ? '' : ', disconnected'}${p.spectator ? ', watching' : ''}${p.rtt_ms != null ? ` - ${p.rtt_ms} ms` : ''}`;
        li.append(face, el('pname', `${p.name}${p.id === me ? ' (you)' : ''}`));
      } else {
        if (p.host) tags.append(tag('host', 'host'));
        else tags.append(p.ready ? tag('ready', 'ok') : tag('not ready', 'wait'));
        if (!p.connected) tags.append(tag('disconnected', 'off'));
        if (p.spectator) tags.append(tag('watching'));
        if (p.rtt_ms != null) tags.append(tag(`${p.rtt_ms} ms`));
        li.append(face, el('pname', `${p.name}${p.id === me ? ' (you)' : ''}`), el('pdrv', app.driver_name(p.combo.driver, 0)), tags);
      }
      voice.decoratePlayer(li, p.id, p.id === me);
      return li;
    }));
    const pl = document.querySelector('#pg-room .panel h3');
    if (pl) pl.textContent = `Players ${humans}/${grid}`;
    const others = room.players.filter((p) => !p.host && p.connected);
    const waiting = others.filter((p) => !p.ready).length;
    $('room-host').hidden = !host;
    $('room-wait').hidden = host;
    $('room-ready-row').hidden = host;
    const racing = room.phase !== 'lobby';
    $('btn-ready').textContent = ready ? 'NOT READY AFTER ALL' : afterRace ? "READY FOR THE NEXT RACE" : "I'M READY";
    $('btn-ready').classList.toggle('primary', !ready);
    $('room-wait').textContent = racing ? 'The race is still running for the others - they come back here when they finish.'
      : ready ? 'You are ready - waiting for the host to start the race...'
        : afterRace ? 'Race over! Everybody is back in the room - press READY when you want to go again.' : 'Waiting for the host to start the race...';
    $('room-wait').classList.toggle('after', afterRace && !ready && !racing);
    $('btn-room-start').disabled = racing || waiting > 0;
    const racers = Math.min(humans, grid);
    const cpus = room.settings.fill_cpus === false ? 0 : Math.max(0, grid - racers);
    $('btn-room-start').textContent = afterRace && !racing ? `RACE AGAIN - ${racers} human${racers === 1 ? '' : 's'} + ${cpus} CPU${cpus === 1 ? '' : 's'}` : `START RACE - ${racers} human${racers === 1 ? '' : 's'} + ${cpus} CPU${cpus === 1 ? '' : 's'}`;
    $('room-start-note').textContent = racing ? 'The race is still running for the others - they come back here when they finish.'
      : waiting > 0 ? `${afterRace ? 'Race over! ' : ''}Waiting for ${waiting} player${waiting > 1 ? 's' : ''} to be ready${afterRace ? ' for the next race' : ''}.`
        : others.length ? 'Everyone is ready!' : 'You can start alone, or wait for friends to join with the code.';
    if (host && document.activeElement !== $('room-course') && room.settings.course && $('room-course').value !== room.settings.course) $('room-course').value = room.settings.course;
    // Racers (grid size): the host's selector mirrors the room; guests only see the number.
    const showRacers = host && gridLive();
    roomRacers.hidden = !showRacers;
    const racersLabel = $('room-racers-label'); if (racersLabel) racersLabel.hidden = !showRacers;
    if (showRacers) { roomRacers.fill(); if (document.activeElement !== roomRacers && Number(roomRacers.value) !== grid) roomRacers.value = String(grid); }
    // The host's checkbox is the source of truth; everyone else mirrors the room (so it is right
    // if they become host).
    if (!host) $('room-public').checked = !!room.settings.public;
    const cc = CC[room.settings.engine_class] || '';
    $('room-settings').textContent = `${courseName.get(room.settings.course) || room.settings.course} ${cc} - ${grid} racers (${racers} human${racers === 1 ? '' : 's'}${cpus ? ` + ${cpus} CPU${cpus === 1 ? '' : 's'}` : ''})${racing ? ' (running - you join the next one)' : ''} - ${room.settings.public ? 'public room' : 'private room (code only)'}`;
  }

  net.on('connection', (e) => {
    const connected = !!e.connected;
    const why = !connected && e && e.code ? ` (code ${e.code}${e.reason ? ': ' + e.reason : ''})` : '';
    const d = window.__mk8Net;
    const never = !connected && d && d.failedOpens > 0 && d.closes === d.failedOpens;
    netStatus(connected ? 'connected' : `${never ? 'cannot reach the room server' : 'connection lost'}${why} - retrying...`, connected ? 'ok' : 'bad');
    if (!connected && net.started()) banner(room ? 'Connection lost - reconnecting...' : '');
    else banner(desynced ? $('net-banner').textContent : '');
  });
  net.on('welcome', (ev) => { netStatus('connected', 'ok'); serverCap = Number(ev && ev.max_players) || net.maxPlayers() || 0; });
  net.on('joined', () => {
    ready = false;
    err();
    if (localFace) { try { net.setFace(localFace); } catch (e) { console.warn('face', e); } }
    show('room');
  });
  net.on('room', (ev) => {
    const first = !room;
    room = ev.room;
    const mine = room.players.find((p) => p.id === net.myId());
    if (mine && !mine.host) ready = mine.ready;
    if (first && room.host === net.myId()) pushSettings();
    renderRoom();
  });
  net.on('left', () => {
    room = null;
    if (app.net_active()) app.abort_net_race();
    if (shown) { show('online'); refreshRooms(); }
  });
  net.on('face', async (ev) => {
    if (faceUrls.has(ev.player)) { URL.revokeObjectURL(faceUrls.get(ev.player)); faceUrls.delete(ev.player); }
    const blob = ev.has_face ? net.face(ev.player) : null;
    if (!blob) { stillFaces.delete(ev.player); app.set_player_face(ev.player, new Uint8Array(0), 0, 0); renderRoom(); return; }
    faceUrls.set(ev.player, URL.createObjectURL(blob));
    try {
      // JPEG has no alpha: re-apply the circle crop the face texture expects.
      const bmp = await createImageBitmap(blob);
      const c = document.createElement('canvas'); c.width = 256; c.height = 256;
      const g = c.getContext('2d');
      g.beginPath(); g.arc(128, 128, 128, 0, Math.PI * 2); g.clip();
      g.drawImage(bmp, 0, 0, 256, 256);
      const rgba = new Uint8Array(g.getImageData(0, 0, 256, 256).data.buffer);
      stillFaces.set(ev.player, rgba.slice());
      app.set_player_face(ev.player, rgba, 256, 256);
    } catch (e) { console.warn('face of player', ev.player, e); }
    renderRoom();
  });
  net.on('race_start', (ev) => {
    const id = ev.start.race_id;
    if (id === doneRace) return; // this page already left that race
    try {
      const fresh = app.start_net_race(net.raceBytes(), ev.kart ?? -1);
      if (fresh) { raceId = id; finishedAt = null; sentDone = false; afterRace = false; desynced = false; banner(''); window.__mk8Checksums = {}; window.__mk8Desync = null; }
      hide();
    } catch (e) { console.error(e); err(String(e.message || e)); }
  });
  net.on('race_ended', () => {
    // Everybody finished (or the host ended it). Racers still driving / spectators go back
    // to the room; a finished racer stays on the results until they leave them (the game
    // then returns to the room, not to its own menus - Front::tick).
    if (app.net_active() && !app.net_local_finished()) {
      banner('The race was ended.');
      setTimeout(() => { if (!desynced) banner(''); }, 3000);
      app.abort_net_race();
    } else if (app.net_ready() && typeof app.detach_net_race === 'function') {
      // Finished: no more bundles will come, so the sim finishes the race on the local clock
      // (otherwise the finish logo froze, waiting for steps that never came).
      app.detach_net_race();
    }
    doneRace = raceId;
  });
  net.on('desync', (ev) => {
    desynced = true;
    window.__mk8Desync = ev;
    banner(`Desync at frame ${ev.frame}: the players' races differ (positions may not match).`);
  });
  net.on('error', (ev) => {
    err(ev.message || ev.code);
    if (ev.code === 'room_not_found' && room) { room = null; if (app.net_active()) app.abort_net_race(); if (shown) show('online'); }
  });
  /** The local face photo as a JPEG for the room (<= 128 KB), or null. */
  let localFace = null;
  onFaceJpeg = (bytes) => {
    localFace = bytes;
    if (room) { try { net.setFace(bytes); } catch (e) { console.warn('face', e); } }
  };

  const face = initFace(app);

  // ---- live camera face (www/live.js): opt-in, clearly shown while on, one tap off ----
  live.initLive(app, {
    commitStill: (c) => face.setImage(c),
    localStill: () => face.stillRgba(),
    remoteStill: (id) => stillFaces.get(id) || null,
    changed: (on) => {
      for (const b of [$('face-live'), $('room-live')]) { b.textContent = on ? 'Live camera face: ON (turn off)' : 'Live camera face: off'; b.setAttribute('aria-pressed', String(on)); }
      $('live-indicator').hidden = !on;
    },
  });
  const toggleLive = async () => {
    $('face-err').textContent = '';
    try { await live.setLive(!live.isLive()); } catch (e) { const m = `camera unavailable: ${e.message || e}`; $('face-err').textContent = m; $('room-err').textContent = m; }
  };
  $('face-live').addEventListener('click', toggleLive);
  $('room-live').addEventListener('click', toggleLive);
  $('live-indicator').addEventListener('click', () => { live.setLive(false); });
  // ---- proximity voice chat (www/voice.js): opt-in, in the room's Options drawer ----
  voice.initVoice(app);
  // One AudioContext: the voices play through the game audio's chat path (limiter, ducking),
  // never straight into the device next to the game mix (that clipped).
  if (audio && audio.available && typeof audio.chat === 'function' && typeof voice.attachAudio === 'function') {
    const chat = audio.chat();
    if (chat) voice.attachAudio(chat);
  }

  // ---- navigation: keyboard + gamepad over the visible controls, with a focus ring ----
  // Arrows / d-pad / stick pick the nearest control in that direction (falling back to document
  // order), Enter / A press it, Esc / Backspace / B go back. The `kb` class shows the ring for
  // focus moved this way; a pointer press hides it again.
  const nav = initNav(home, { back, show });
  function back() {
    const page = home.dataset.page;
    const open = document.querySelector('#home .page.on details[open]');
    if (open && (open.contains(document.activeElement) || page === 'main')) { open.open = false; open.querySelector('summary').focus(); return true; }
    if (page === 'room') { $('btn-leave').click(); return true; }
    const b = document.querySelector('#home .page.on button.back');
    if (b) { b.click(); return true; }
    return false;
  }

  let shown = false;
  function hide() { shown = false; document.body.classList.remove('home'); if (document.activeElement instanceof HTMLElement) document.activeElement.blur(); }
  return {
    /** Hide the custom menu without discarding its state; it can be shown again later. */
    hide,
    /** Called every frame: show the menu when the game UI went back to a replaced page. */
    poll() {
      // A finished racer tells the server once the results board is up (not only when they
      // leave it): the room goes back to the lobby when the last racer reaches the results,
      // whoever is still reading them. Not earlier: the finish logo and the results need sim
      // steps, and none come once the server ends the race (App.detach_net_race covers a
      // race another player's race_done ended meanwhile).
      if (raceId !== null && raceId !== doneRace && !sentDone && net.racing() && app.net_local_finished()) {
        finishedAt ??= performance.now();
        const board = /^(Results|RaceNext|GpResults)$/.test(app.screen_name());
        if (board || performance.now() - finishedAt > 15000) { sentDone = true; try { net.raceDone(); } catch (e) { console.warn('race_done', e); } }
      }
      if (app.at_home() && !shown) {
        shown = true;
        document.body.classList.add('home');
        if (raceId !== null && raceId !== doneRace && !sentDone && net.racing()) { sentDone = true; net.raceDone(); }
        if (raceId !== null) { afterRace = !!room; doneRace = raceId; }
        if (!desynced) banner('');
        if (room) { show('room'); renderRoom(); } else show('main');
        brand.brandStart();
      }
      if (shown) nav.pollGamepad(performance.now());
    },
    get shown() { return shown; },
  };
}

// ---- "Racers" selector (2..=cap) and the compact player grid for big rooms ----
/** A <select> of 2..=cap() with a `fill()` that rebuilds the options when the cap changes. */
function racersSelect(id, cap) {
  const sel = document.createElement('select');
  sel.id = id;
  let built = 0;
  sel.fill = () => {
    const n = Math.max(2, Math.min(255, Math.round(cap())));
    if (n === built) return;
    const keep = sel.value || '12';
    sel.replaceChildren(...Array.from({ length: n - 1 }, (_, i) => {
      const o = document.createElement('option'); o.value = String(i + 2); o.textContent = i + 2 === 12 ? '12 (the game)' : String(i + 2); return o;
    }));
    sel.value = Number(keep) <= n ? keep : String(n);
    built = n;
  };
  sel.fill();
  sel.value = '12';
  if (!sel.value) sel.value = String(built);
  return sel;
}
/** Styles for the selector row and the compact player grid (kept here so www/menu.css stays untouched). */
function injectRacerStyles() {
  if (document.getElementById('racers-style')) return;
  const st = document.createElement('style');
  st.id = 'racers-style';
  st.textContent = `
#home .racers-row { margin: 10px 0 4px; gap: 10px; }
#home .racers-row label { font-weight: 900; }
#home .racers-row .note { margin: 0; }
#home ul.players.compact { grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; max-height: 46vh; overflow-y: auto; padding: 4px; }
#home ul.players.compact li { min-height: 0; padding: 6px 4px 5px; gap: 2px; border-width: 2px; border-radius: 12px; grid-template-rows: auto auto; box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3); }
#home ul.players.compact .pface { width: 36px; height: 36px; font-size: 16px; border-width: 2px; }
#home ul.players.compact .pname { font-size: 11px; line-height: 1.1; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#home ul.players.compact li::after { content: ""; position: absolute; top: 5px; right: 5px; width: 9px; height: 9px; border-radius: 50%; background: var(--mk-yellow); box-shadow: 0 0 0 2px #fff; }
#home ul.players.compact li.st-ok::after { background: var(--mk-green); }
#home ul.players.compact li.st-host::after { background: var(--mk-red); }
#home ul.players.compact li.st-off::after { background: #666; }
#home ul.players.compact .voice-dot { top: 3px; left: 3px; }
#home ul.players.compact .voice-mute { top: auto; bottom: 2px; right: 2px; padding: 0 5px; font-size: 9px; }
`;
  document.head.append(st);
}

// ---- keyboard / gamepad navigation of the menu's controls ----
function initNav(home, { back }) {
  const SEL = '#home .page.on button:not([hidden]):not(:disabled), #home .page.on select, #home .page.on input:not([type=hidden]):not([type=file]), #home .page.on summary';
  const visible = (el) => el.offsetParent !== null && !el.closest('[hidden]');
  const focusables = () => [...document.querySelectorAll(SEL)].filter(visible);
  const typing = (el) => el instanceof HTMLInputElement && (el.type === 'text' || el.type === 'search' || el.type === 'number');
  const kb = () => home.classList.add('kb');
  home.addEventListener('pointerdown', () => home.classList.remove('kb'));

  function focusEl(el) {
    if (!el) return;
    kb();
    el.focus({ preventScroll: true });
    el.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }
  /** Move the focus in `dir` ('up' | 'down' | 'left' | 'right'). */
  function move(dir) {
    const items = focusables();
    if (!items.length) return;
    const cur = document.activeElement;
    const ci = items.indexOf(cur);
    if (ci < 0) { focusEl(items[0]); return; }
    const r = cur.getBoundingClientRect();
    const cx = r.left + r.width / 2; const cy = r.top + r.height / 2;
    let best = null; let bestScore = Infinity;
    for (const el of items) {
      if (el === cur) continue;
      const b = el.getBoundingClientRect();
      const x = b.left + b.width / 2; const y = b.top + b.height / 2;
      const dx = x - cx; const dy = y - cy;
      let primary; let overlap;
      if (dir === 'down') { primary = dy; overlap = b.left < r.right && b.right > r.left; }
      else if (dir === 'up') { primary = -dy; overlap = b.left < r.right && b.right > r.left; }
      else if (dir === 'right') { primary = dx; overlap = b.top < r.bottom && b.bottom > r.top; }
      else { primary = -dx; overlap = b.top < r.bottom && b.bottom > r.top; }
      if (primary < 4) continue;
      const secondary = dir === 'up' || dir === 'down' ? Math.abs(dx) : Math.abs(dy);
      const score = primary + (overlap ? 0 : 2 * secondary + 400);
      if (score < bestScore) { bestScore = score; best = el; }
    }
    if (!best) {
      // Nothing that way: document order (lists keep working, left / right at an edge go on).
      const step = dir === 'down' || dir === 'right' ? 1 : -1;
      best = items[(ci + step + items.length) % items.length];
    }
    focusEl(best);
  }
  /** Left / right on a select or slider changes its value instead of moving. */
  function adjust(el, delta) {
    if (el instanceof HTMLSelectElement) {
      const i = Math.max(0, Math.min(el.options.length - 1, el.selectedIndex + delta));
      if (i !== el.selectedIndex) { el.selectedIndex = i; el.dispatchEvent(new Event('change', { bubbles: true })); }
      return true;
    }
    if (el instanceof HTMLInputElement && el.type === 'range') {
      const step = Number(el.step) || 1;
      el.value = String(Math.max(Number(el.min), Math.min(Number(el.max), Number(el.value) + delta * step)));
      el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    }
    return false;
  }
  function activate() {
    const el = document.activeElement;
    if (!(el instanceof HTMLElement) || !home.contains(el)) { focusEl(focusables()[0]); return; }
    if (el instanceof HTMLSelectElement) { adjust(el, 1); return; }
    if (typing(el)) return;
    el.click();
  }

  // On the window: the focus may sit on the game canvas or the body (after a race, after a
  // click on the backdrop); the first arrow then enters the menu.
  window.addEventListener('keydown', (e) => {
    if (!document.body.classList.contains('home')) return;
    const t = e.target;
    const dirs = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right' };
    if (!(t instanceof Node) || !home.contains(t)) {
      if (dirs[e.key] || e.key === 'Enter') { focusEl(focusables()[0]); e.preventDefault(); }
      else if (e.key === 'Escape' || e.key === 'Backspace') { if (back()) e.preventDefault(); }
      return;
    }
    if (dirs[e.key]) {
      // Selects and sliders use the arrows themselves; text inputs keep left / right.
      if (t instanceof HTMLSelectElement || (t instanceof HTMLInputElement && t.type === 'range')) return;
      if (typing(t) && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) return;
      move(dirs[e.key]); e.preventDefault(); return;
    }
    if (e.key === 'Escape' || (e.key === 'Backspace' && !typing(t))) { if (back()) e.preventDefault(); return; }
    if (e.key === 'Enter' && typing(t) && t.id !== 'join-code') { move('down'); e.preventDefault(); }
  });

  // Gamepad (standard mapping): d-pad 12-15 / left stick, A = 0, B = 1. Edge-triggered, with
  // key repeat while a direction is held. Button 11 (right stick) belongs to push-to-talk.
  const gp = { prev: 0, dirs: 0, repeatAt: 0 };
  function pollGamepad(now) {
    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
    let bits = 0;
    for (const p of pads) {
      if (!p || !p.connected) continue;
      const on = (i) => p.buttons[i] && p.buttons[i].pressed;
      if (on(12)) bits |= 1; if (on(13)) bits |= 2; if (on(14)) bits |= 4; if (on(15)) bits |= 8;
      if (on(0)) bits |= 16; if (on(1)) bits |= 32;
      const x = p.axes[0] || 0; const y = p.axes[1] || 0;
      if (y < -0.5) bits |= 1; if (y > 0.5) bits |= 2; if (x < -0.5) bits |= 4; if (x > 0.5) bits |= 8;
    }
    const pressed = bits & ~gp.prev;
    const dirs = bits & 15;
    let fire = pressed & 15;
    if (dirs && dirs === gp.dirs) { if (now >= gp.repeatAt) { fire |= dirs; gp.repeatAt = now + 120; } }
    else gp.repeatAt = now + 380;
    gp.dirs = dirs; gp.prev = bits;
    if (fire) {
      const el = document.activeElement;
      const horizontal = (fire & 4 ? -1 : 0) + (fire & 8 ? 1 : 0);
      if (horizontal && home.contains(el) && adjust(el, horizontal)) { kb(); }
      else if (fire & 1) move('up'); else if (fire & 2) move('down'); else if (fire & 4) move('left'); else if (fire & 8) move('right');
    }
    if (pressed & 16) activate();
    if (pressed & 32) back();
  }
  return { pollGamepad, move, activate };
}

// ---- sound: the game's menu sounds on hover / click, volume settings (www/audio.js) ----
function initSound(audio) {
  const box = $('sound-box');
  if (!audio || !audio.available) { if (box) box.hidden = true; return; }
  const home = $('home');
  let lastCursor = 0;
  const cursor = () => {
    const t = performance.now();
    if (t - lastCursor < 60) return; // one tick per move, not per pixel
    lastCursor = t;
    audio.ui('SE_SYS_CURSOR');
  };
  const control = (t) => t instanceof Element && t.closest('#home button, #home select, #home summary, #home input[type=checkbox], #home input[type=range]');
  home.addEventListener('focusin', (e) => { if (control(e.target)) cursor(); });
  home.addEventListener('pointerover', (e) => { const c = control(e.target); if (c && c !== document.activeElement && !(e.relatedTarget && c.contains(e.relatedTarget))) cursor(); });
  home.addEventListener('click', (e) => {
    const b = e.target instanceof Element ? e.target.closest('#home button, #home summary') : null;
    if (!b) return;
    audio.ui(b.classList.contains('back') || b.id === 'btn-leave' ? 'SE_SYS_CANCEL_M' : (b.classList.contains('big') ? 'SE_SYS_DECIDE_L' : 'SE_SYS_DECIDE_M'));
  });
  if (!box) return;
  const s = audio.settings();
  const sliders = { music: $('vol-music'), sfx: $('vol-sfx'), voice: $('vol-voice') };
  for (const [k, el] of Object.entries(sliders)) {
    el.value = String(Math.round(s[k] * 100));
    el.addEventListener('input', () => audio.setSettings({ [k]: Number(el.value) / 100 }));
    el.addEventListener('change', () => { if (k !== 'music') audio.ui(k === 'voice' ? 'SE_SYS_DECIDE_S' : 'SE_SYS_CURSOR'); });
  }
  const mute = $('vol-mute');
  mute.checked = s.mute;
  mute.addEventListener('change', () => audio.setSettings({ mute: mute.checked }));
}

// ---- face photo: camera / upload, circle crop, 256x256 RGBA to wasm ----
function initFace(app) {
  const cv = $('face-preview');
  const ctx = cv.getContext('2d');
  const video = $('face-video');
  let img = null; // ImageBitmap / canvas with the source picture
  let still = null; // committed 256x256 RGBA
  let stream = null;
  let crop = { x: 128, y: 128, r: 100 }; // circle in preview pixels
  let view = { scale: 1, ox: 0, oy: 0 }; // source -> preview fit
  const err = (m) => { $('face-err').textContent = m || ''; };

  function fit() {
    if (!img) return;
    const s = Math.min(256 / img.width, 256 / img.height);
    view = { scale: s, ox: (256 - img.width * s) / 2, oy: (256 - img.height * s) / 2 };
  }
  function draw() {
    ctx.fillStyle = '#0e2a66'; ctx.fillRect(0, 0, 256, 256);
    const src = stream ? video : img;
    if (stream && video.videoWidth) {
