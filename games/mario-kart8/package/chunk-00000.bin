// Host output transform (not part of the game program).
struct Mk8Post {
    p: vec4<f32>,
    q: vec4<f32>,
}
@group(¿) @binding(¿Ä) var<uniform> mk8_post_u: Mk8Post;

fn mk8_soft_clip(c: vec3<f32>) -> vec3<f32> {
    let k = 0.8;
    let m = max(max(c.r, c.g), c.b);
    if (m <= k) {
        return c;
    }
    let mapped = k + (1.0 - k) * (1.0 - exp(-(m - k) / (1.0 - k)));
    let scaled = c * (mapped / m);
    let white = clamp((m - 1.0) / 3.0, 0.0, 1.0);
    return mix(scaled, vec3<f32>(mapped), white * 0.6);
}

fn mk8_post(c_in: vec4<f32>) -> vec4<f32> {
    var c = c_in.rgb * mk8_post_u.p.w;
    // NaN / Inf guard: never write non-finite colours.
    c = select(vec3<f32>(0.0), c, (c == c) & (abs(c) < vec3<f32>(1e30)));
    var a = c_in.a;
    if (!(a == a)) {
        a = 1.0;
    }
    if (mk8_post_u.p.z > 0.5) {
        let luma = dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));
        c = max(mix(vec3<f32>(luma), c, mk8_post_u.q.x), vec3<f32>(0.0)) * mk8_post_u.q.y;
        let g = mk8_post_u.q.z;
        if (abs(g - 1.0) > 1e-3 && g > 0.0) {
            c = pow(c, vec3<f32>(1.0 / g));
        }
    }
    if (mk8_post_u.p.y > 0.5) {
        c = mk8_soft_clip(max(c, vec3<f32>(0.0)));
    }
    if (mk8_post_u.p.x > 0.5) {
        let x = clamp(c, vec3<f32>(0.0), vec3<f32>(1.0));
        c = select(1.055 * pow(x, vec3<f32>(1.0 / 2.4)) - 0.055, x * 12.92, x <= vec3<f32>(0.0031308));
    }
    return vec4<f32>(c, a);
}
