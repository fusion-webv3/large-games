struct SkyUniforms {
    view_proj: mat4x4<f32>,
    model: mat4x4<f32>,
    // x: 1 = sRGB-encode output (linear target), y: brightness multiplier
    params: vec4<f32>,
};
@group(0) @binding(0) var<uniform> u: SkyUniforms;
@group(1) @binding(0) var t_albedo: texture_2d<f32>;
@group(1) @binding(1) var s_albedo: sampler;

struct VsIn {
    @location(0) position: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) uv: vec2<f32>,
    @location(3) color: vec4<f32>,
};
struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) uv: vec2<f32>,
    @location(1) color: vec4<f32>,
};

@vertex
fn vs_main(v: VsIn) -> VsOut {
    var o: VsOut;
    let p = u.view_proj * (u.model * vec4<f32>(v.position, 1.0));
    // Pin to just inside the far plane so the dome is never clipped by it.
    o.clip = vec4<f32>(p.xy, p.w * 0.99999, p.w);
    o.uv = v.uv;
    o.color = v.color;
    return o;
}

fn srgb_encode(c: vec3<f32>) -> vec3<f32> {
    let lo = c * 12.92;
    let hi = 1.055 * pow(c, vec3<f32>(1.0 / 2.4)) - 0.055;
    return select(hi, lo, c <= vec3<f32>(0.0031308));
}

@fragment
fn fs_main(i: VsOut) -> @location(0) vec4<f32> {
    let tex = textureSample(t_albedo, s_albedo, i.uv);
    if (tex.a < 0.5) {
        discard;
    }
    var rgb = clamp(tex.rgb * u.params.y, vec3<f32>(0.0), vec3<f32>(1.0));
    if (u.params.x > 0.5) {
        rgb = srgb_encode(rgb);
    }
    return vec4<f32>(rgb, 1.0);
}
