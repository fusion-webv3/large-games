␀␀␀gsys_shape slots°ñ␀␀␀␀;␀␀)␀␀␀°ñ␀␀␀␀9␀␀*␀␀␀°ñ␀␀␀␀Ã␀␀)␀␀␀buffer 0 always exists␀␀°ñ␀␀␀␀Ê␀␀+␀␀␀°ñ␀␀␀␀‹␀␀T␀␀␀°ñ␀␀␀␀‹␀␀␀␀␀mk8 native vertices␀°ñ␀␀␀␀␀␀6␀␀␀, ␀␀°ñ␀␀␀␀W␀␀ ␀␀␀gsys_color_buffer␀␀␀°ñ␀␀␀␀Á␀␀,␀␀␀°ñ␀␀␀␀Î␀␀-␀␀␀°ñ␀␀␀␀ı␀␀␀␀␀°ñ␀␀␀␀␀␀␀␀␀°ñ␀␀␀␀␀␀␀␀␀°ñ␀␀␀␀␀␀␀␀␀°ñ␀␀␀␀␀␀2␀␀␀°ñ␀␀␀␀␀␀?␀␀␀°ñ␀␀␀␀Z␀␀␀␀␀°ñ␀␀␀␀]␀␀␀␀␀°ñ␀␀␀␀^␀␀␀␀␀°ñ␀␀␀␀␀␀)␀␀␀3D texturecube arrays need the Wgpu targetsampler␀␀<␀<␀<␀<aux 2daux 2d arrayaux cube…µ␀␀␀␀ ␀␀␀␀␀…µ␀␀␀␀ﬁ␀␀O␀␀␀…µ␀␀␀␀ﬁ␀␀ ␀␀␀mk8 main passmk8 material pipeline␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ ␀␀␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀0␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀@␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀P␀␀␀␀␀␀␀␀␀␀␀␀␀␀mk8 material…µ␀␀␀␀Ë␀␀␀␀␀chunk just picked␀␀␀…µ␀␀␀␀Ë␀␀-␀␀␀mk8 material bg␀…µ␀␀␀␀a␀␀,␀␀␀…µ␀␀␀␀i␀␀$␀␀␀mk8_render␀␀…µ␀␀␀␀5␀␀␀␀␀mk8 instancesmk8 shader// mk8-render material shader. APPROXIMATION of MK8 Deluxe's Turbo_UBER shader driven by the real
// FMAT options/params (see docs/render/MATERIALS.md and src/material.rs). WebGL2-safe: uniforms
// only, 7 textures + 7 samplers in group 1, all textures sampled in uniform control flow. The
// model transform comes in as per-instance vertex attributes (lib.rs `Instance`), so a run of
// items sharing material and mesh is one instanced draw.

// Mirrors env.rs `EnvironmentUniform` (owned by the environment code).
struct EnvironmentU {
    // xyz towards the sun, w exposure
    sun_dir: vec4<f32>,
    // rgb sun colour, a character sun scale
    sun_color: vec4<f32>,
    // rgb course hemisphere sky, a saturation
    hemi_sky: vec4<f32>,
    // rgb course hemisphere ground, a gamma
    hemi_ground: vec4<f32>,
    // rgb character hemisphere sky, a brightness
    chara_hemi_sky: vec4<f32>,
    // rgb character hemisphere ground, a bloom threshold
    chara_hemi_ground: vec4<f32>,
    // rgb fog colour, a max opacity (0 = off)
    fog_color: vec4<f32>,
    // x start, y 1 / (end - start), z bloom intensity
    fog_range: vec4<f32>,
    height_fog_color: vec4<f32>,
    // x start, y 1 / (end - start)
    height_fog_range: vec4<f32>,
    // xyz axis: height fog distance = dot(world, axis)
    height_fog_axis: vec4<f32>,
};

struct Globals {
    view_proj: mat4x4<f32>,
    // xyz camera position
    eye: vec4<f32>,
    // xyz camera forward (unit)
    cam_fwd: vec4<f32>,
    // legacy: xyz = direction *towards* the light for plain (non-material) meshes
    light_dir: vec4<f32>,
    // x = legacy ambient factor, y = 1.0 when the shader must encode linear -> sRGB itself
    // (target format is not an sRGB format, e.g. a WebGL2/WebGPU canvas), z = debug view, w = time
    params: vec4<f32>,
    // x bake light scale, y tonemap (0/1), z specular scale, w colour grading (0/1)
    misc: vec4<f32>,
    // rgb light-probe ambient for materials without baked light (0 = use the hemisphere only)
    probe: vec4<f32>,
    env: EnvironmentU,
};

struct Material {
    // x flags, y texcoord selects, z bake_shadow_type + 1, w multi_tex_calc_type_color
    flags: vec4<u32>,
    albedo: vec4<f32>,
    emission: vec4<f32>,
    specular: vec4<f32>,
    fresnel: vec4<f32>,
    edge: vec4<f32>,
    bake_st0: vec4<f32>,
    bake_st1: vec4<f32>,
    bake_light: vec4<f32>,
    density: vec4<f32>,
    tex_mtx: array<vec4<f32>, 6>,
    multi_reg: array<vec4<f32>, 3>,
    transmit: vec4<f32>,
};

const F_MATERIAL: u32 = 1u;
const F_ALBEDO_TEX: u32 = 2u;
const F_NORMAL: u32 = 4u;
const F_SPECULAR: u32 = 16u;
const F_SPEC_MASK: u32 = 32u;
const F_SPEC_MASK_COLOR: u32 = 64u;
const F_EMISSION: u32 = 128u;
const F_EMISSION_MAP: u32 = 256u;
const F_VTX_COLOR_DIFF: u32 = 512u;
const F_VTX_COLOR_EMISSION: u32 = 1024u;
const F_BAKE_SHADOW: u32 = 2048u;
const F_BAKE_LIGHT: u32 = 4096u;
const F_FRESNEL: u32 = 8192u;
const F_EDGE_LIGHT: u32 = 16384u;
const F_ALPHA_TEST: u32 = 32768u;
const F_TRANSLUCENT: u32 = 65536u;
const F_FOG: u32 = 131072u;
const F_FOG_Y: u32 = 262144u;
const F_VTX_ALPHA: u32 = 524288u;
const F_MULTI: u32 = 1048576u;
const F_BAKE_AO: u32 = 4194304u;
const F_DIFFUSE: u32 = 8388608u;
const F_NO_SUN: u32 = 2097152u;
const F_SPEC_SHADOW_LINK: u32 = 16777216u;
const F_VTX_COLOR_SPEC: u32 = 67108864u;
const F_VTX_COLOR_EDGE: u32 = 134217728u;
const F_CHARA: u32 = 1073741824u;
const F_OPA_TRANS: u32 = 2147483648u;

@group(0) @binding(0) var<uniform> globals: Globals;
@group(1) @binding(0) var<uniform> mat: Material;
@group(1) @binding(1) var t_albedo: texture_2d<f32>;
@group(1) @binding(2) var t_normal: texture_2d<f32>;
@group(1) @binding(3) var t_spec: texture_2d<f32>;
@group(1) @binding(4) var t_emission: texture_2d<f32>;
@group(1) @binding(5) var t_bake0: texture_2d<f32>;
@group(1) @binding(6) var t_bake1: texture_2d<f32>;
@group(1) @binding(7) var t_albedo2: texture_2d<f32>;
@group(1) @binding(8) var s_albedo: sampler;
@group(1) @binding(9) var s_normal: sampler;
@group(1) @binding(10) var s_spec: sampler;
@group(1) @binding(11) var s_emission: sampler;
@group(1) @binding(12) var s_bake0: sampler;
@group(1) @binding(13) var s_bake1: sampler;
@group(1) @binding(14) var s_albedo2: sampler;

struct VsIn {
    @location(0) position: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) uv0: vec2<f32>,
    @location(3) color: vec4<f32>,
    @location(4) tangent: vec4<f32>,
    @location(5) uv1: vec2<f32>,
    @location(6) uv23: vec4<f32>,
    // Per instance: rows 0-2 of the model matrix and of its normal matrix (inverse transpose).
    @location(7) i_m0: vec4<f32>,
    @location(8) i_m1: vec4<f32>,
    @location(9) i_m2: vec4<f32>,
    @location(10) i_n0: vec4<f32>,
    @location(11) i_n1: vec4<f32>,
    @location(12) i_n2: vec4<f32>,
};

struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) world: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) tangent: vec4<f32>,
    @location(3) uv01: vec4<f32>,
    @location(4) uv23: vec4<f32>,
    @location(5) color: vec4<f32>,
};

@vertex
fn vs_main(v: VsIn) -> VsOut {
    var o: VsOut;
    let p = vec4<f32>(v.position, 1.0);
    let world = vec3<f32>(dot(v.i_m0, p), dot(v.i_m1, p), dot(v.i_m2, p));
    o.clip = globals.view_proj * vec4<f32>(world, 1.0);
    o.world = world;
    o.normal = vec3<f32>(dot(v.i_n0.xyz, v.normal), dot(v.i_n1.xyz, v.normal), dot(v.i_n2.xyz, v.normal));
    let t = v.tangent.xyz;
    o.tangent = vec4<f32>(dot(v.i_m0.xyz, t), dot(v.i_m1.xyz, t), dot(v.i_m2.xyz, t), v.tangent.w);
    o.uv01 = vec4<f32>(v.uv0, v.uv1);
    o.uv23 = v.uv23;
    o.color = v.color;
    return o;
}

fn has(bit: u32) -> bool {
    return (mat.flags.x & bit) != 0u;
}

fn tex_xform(m: u32, uv: vec2<f32>) -> vec2<f32> {
    let p = vec3<f32>(uv, 1.0);
    return vec2<f32>(dot(mat.tex_mtx[m * 2u].xyz, p), dot(mat.tex_mtx[m * 2u + 1u].xyz, p));
}

fn pick_tc(sel: u32, tc0: vec2<f32>, tc2: vec2<f32>, tc3: vec2<f32>) -> vec2<f32> {
    return select(select(tc0, tc2, sel == 2u), tc3, sel == 3u);
}

fn safe_normalize(v: vec3<f32>, fallback: vec3<f32>) -> vec3<f32> {
    let l = length(v);
    return select(fallback, v / l, l > 1e-6);
}

fn soft_clip(c: vec3<f32>) -> vec3<f32> {
    // Identity below 0.8; above, the largest channel rolls off smoothly towards 1.0 and the
    // colour is scaled with it (hue kept), then slightly desaturated as it approaches white.
    let k = 0.8;
    let m = max(max(c.r, c.g), c.b);
    if (m <= k) {
        return c;
    }
    let mapped = k + (1.0 - k) * (1.0 - exp(-(m - k) / (1.0 - k)));
    let scaled = c * (mapped / m);
    let white = clamp((m - 1.0) / 3.0, 0.0, 1.0);
    return mix(scaled, vec3<f32>(mapped), white * 0.6);
}

// Colour grading from the course colour correction: saturation, brightness, gamma (1 = identity).
fn grade(c: vec3<f32>, saturation: f32, brightness: f32, gamma: f32) -> vec3<f32> {
    let luma = dot(c, vec3<f32>(0.2126, 0.7152, 0.0722));
    var o = max(mix(vec3<f32>(luma), c, saturation), vec3<f32>(0.0)) * brightness;
    if (abs(gamma - 1.0) > 1e-3 && gamma > 0.0) {
        o = pow(o, vec3<f32>(1.0 / gamma));
    }
    return o;
}

fn linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
    let x = clamp(c, vec3<f32>(0.0), vec3<f32>(1.0));
    let lo = x * 12.92;
    let hi = 1.055 * pow(x, vec3<f32>(1.0 / 2.4)) - 0.055;
    return select(hi, lo, x <= vec3<f32>(0.0031308));
}

fn finish(rgb: vec3<f32>, a: f32) -> vec4<f32> {
    var c = rgb;
    if (globals.params.y > 0.5) {
        c = linear_to_srgb(c);
    }
    return vec4<f32>(c, a);
}

@fragment
fn fs_main(i: VsOut, @builtin(front_facing) front: bool) -> @location(0) vec4<f32> {
    let sels = mat.flags.y;
    let uv0 = i.uv01.xy;
    let uv1 = i.uv01.zw;
    let tc0 = tex_xform(0u, uv0);
    let tc2 = tex_xform(1u, i.uv23.xy);
    let tc3 = tex_xform(2u, i.uv23.zw);
    let uv_n = pick_tc(sels & 3u, tc0, tc2, tc3);
    let uv_s = pick_tc((sels >> 2u) & 3u, tc0, tc2, tc3);
    let uv_e = pick_tc((sels >> 4u) & 3u, tc0, tc2, tc3);
    let uv_m = pick_tc((sels >> 6u) & 3u, tc0, tc2, tc3);
    let b0uv = uv1 * mat.bake_st0.xy + mat.bake_st0.zw;
    let b1uv = uv1 * mat.bake_st1.xy + mat.bake_st1.zw;

    // Sample everything up front (uniform control flow for implicit derivatives).
    let s_alb = textureSample(t_albedo, s_albedo, tc0);
    let s_nrm = textureSample(t_normal, s_normal, uv_n);
    let s_spc = textureSample(t_spec, s_spec, uv_s);
    let s_emi = textureSample(t_emission, s_emission, uv_e);
    let s_b0 = textureSample(t_bake0, s_bake0, b0uv);
    let s_b1 = textureSample(t_bake1, s_bake1, b1uv);
    let s_a2 = textureSample(t_albedo2, s_albedo2, uv_m);

    var geo_n = safe_normalize(i.normal, vec3<f32>(0.0, 1.0, 0.0));
    if (!front) {
        geo_n = -geo_n;
    }

    // ---- Plain meshes (no FMAT): the original lit/textured shading. ----
    if (!has(F_MATERIAL)) {
        let base = s_alb * i.color;
        if (base.a < 0.5) {
            discard;
        }
        var ndotl = 1.0;
        if (length(i.normal) > 1e-6) {
            ndotl = max(dot(geo_n, globals.light_dir.xyz), 0.0);
        }
        let ambient = globals.params.x;
        let light = ambient + (1.0 - ambient) * ndotl;
        return finish(base.rgb * light, 1.0);
    }

    // ---- Albedo ----
    var albedo = vec4<f32>(1.0);
    if (has(F_ALBEDO_TEX)) {
        albedo = s_alb;
    }
    if (has(F_MULTI)) {
        // multi_tex_calc_type_color 7 = decal overlay using the layer's alpha (logos on gates,
        // balloons, dam walls). The other 28 modes are not decoded yet and leave the base
        // albedo unchanged (APPROXIMATE).
        if (mat.flags.w == 7u) {
            let layer = s_a2 * mat.multi_reg[0];
            albedo = vec4<f32>(mix(albedo.rgb, layer.rgb, clamp(layer.a, 0.0, 1.0)), albedo.a);
        }
    }
    albedo = vec4<f32>(albedo.rgb * mat.albedo.rgb, albedo.a);
    if (has(F_VTX_COLOR_DIFF)) {
        albedo = vec4<f32>(albedo.rgb * i.color.rgb, albedo.a);
    }
    if (has(F_VTX_ALPHA)) {
        albedo.a = albedo.a * i.color.a;
    }
    if (has(F_ALPHA_TEST) && albedo.a < mat.albedo.a) {
        discard;
    }

    // ---- Normal ----
    var n = geo_n;
    if (has(F_NORMAL)) {
        var t = i.tangent.xyz - geo_n * dot(geo_n, i.tangent.xyz);
        t = safe_normalize(t, vec3<f32>(0.0));
        if (dot(t, t) > 0.5) {
            let w = select(1.0, -1.0, i.tangent.w < 0.0);
            let b = cross(geo_n, t) * w;
            let xy = s_nrm.rg * 2.0 - vec2<f32>(1.0);
            let z = sqrt(max(1.0 - dot(xy, xy), 0.0));
            let mapped = safe_normalize(t * xy.x + b * xy.y + geo_n * z, geo_n);
            n = safe_normalize(mix(geo_n, mapped, clamp(mat.density.z * 2.0, 0.0, 1.0)), geo_n);
        }
    }

    // ---- Lighting ----
    let env = globals.env;
    let l = env.sun_dir.xyz;
    let v = safe_normalize(globals.eye.xyz - i.world, vec3<f32>(0.0, 1.0, 0.0));
    let ndl = max(dot(n, l), 0.0);
    let ndv = clamp(dot(n, v), 0.0, 1.0);
    var ao = 1.0;
    var shadow = 1.0;
    if (has(F_BAKE_AO)) {
        ao = mix(1.0, s_b0.r, clamp(mat.density.y, 0.0, 1.0));
    }
    if (has(F_BAKE_SHADOW)) {
        shadow = mix(1.0, s_b0.g, clamp(mat.density.x, 0.0, 1.0));
    }
    let chara = has(F_CHARA);
    let sky_c = select(env.hemi_sky.rgb, env.chara_hemi_sky.rgb, chara);
    let ground_c = select(env.hemi_ground.rgb, env.chara_hemi_ground.rgb, chara);
    let sun_c = env.sun_color.rgb * select(1.0, max(env.sun_color.a, 0.0), chara);
    var hemi = mix(ground_c, sky_c, n.y * 0.5 + 0.5);
    var bake_light = vec3<f32>(0.0);
    if (has(F_BAKE_LIGHT)) {
        bake_light = s_b1.rgb * s_b1.a * mat.bake_light.rgb * globals.misc.x;
    } else {
        // No baked indirect light: the game lights these from the course light probes. Use
        // their average (set by the host) on top of the hemisphere.
        hemi = hemi + globals.probe.rgb * (0.75 + 0.25 * n.y);
    }
    let sun_k = select(1.0, 0.0, has(F_NO_SUN));
    var light = sun_c * ndl * shadow * sun_k + hemi * ao + bake_light;
    if (has(F_OPA_TRANS)) {
        // Sunlight through thin foliage when lit from behind (APPROXIMATE).
        light += sun_c * max(-dot(n, l), 0.0) * mat.transmit.rgb * 0.35 * mix(1.0, shadow, mat.transmit.a);
    }

    var color = vec3<f32>(0.0);
    if (has(F_DIFFUSE)) {
        color = albedo.rgb * light;
    }

    // ---- Specular (sun highlight) + fresnel reflection ----
    let spec_scale = globals.misc.z;
    if (has(F_SPECULAR)) {
        var mask = vec3<f32>(1.0);
        if (has(F_SPEC_MASK)) {
            mask = select(vec3<f32>(s_spc.r), s_spc.rgb, has(F_SPEC_MASK_COLOR));
        }
        if (has(F_VTX_COLOR_SPEC)) {
            mask = mask * i.color.rgb;
        }
        let rough = clamp(mat.specular.a, 0.0, 1.0);
        let power = exp2(1.0 + 10.0 * (1.0 - rough));
        let h = safe_normalize(l + v, n);
        let fres = mat.fresnel.z + (mat.fresnel.x - mat.fresnel.z) * pow(1.0 - ndv, 5.0 * max(mat.fresnel.y, 0.05));
        let spec = pow(max(dot(n, h), 0.0), power) * (power + 2.0) / 8.0;
        color += mat.specular.rgb * mask * spec * sun_c * ndl * shadow * clamp(fres, 0.0, 1.0) * spec_scale;
        if (has(F_FRESNEL)) {
            let r = reflect(-v, n);
            let refl = mix(ground_c, sky_c, r.y * 0.5 + 0.5);
            let f = pow(1.0 - ndv, max(mat.fresnel.w, 1.0));
            color += refl * mat.specular.rgb * mask * f * ao * spec_scale;
        }
    }

    // ---- Rim / edge light ----
    if (has(F_EDGE_LIGHT)) {
        var e = mat.edge.rgb * pow(1.0 - ndv, 2.0 + 2.0 * max(mat.edge.a, 0.0));
        if (has(F_VTX_COLOR_EDGE)) {
            e = e * i.color.rgb;
        }
        color += e * mix(1.0, ao, 0.5) * spec_scale;
    }

    // ---- Emission ----
    if (has(F_EMISSION)) {
        var e = mat.emission.rgb;
        if (has(F_EMISSION_MAP)) {
            e = e * s_emi.rgb;
        }
        if (has(F_VTX_COLOR_EMISSION)) {
            e = e * i.color.rgb;
        }
        color += e;
    }

    color = color * env.sun_dir.w;

    // ---- Fog (after exposure: fog colours are display-referred) ----
    if (has(F_FOG)) {
        let d = dot(i.world - globals.eye.xyz, globals.cam_fwd.xyz);
        let ff = clamp((d - env.fog_range.x) * env.fog_range.y, 0.0, 1.0) * env.fog_color.a;
        color = mix(color, env.fog_color.rgb, ff);
    }
    if (has(F_FOG_Y)) {
        let hd = dot(i.world, env.height_fog_axis.xyz);
        let hf = clamp((hd - env.height_fog_range.x) * env.height_fog_range.y, 0.0, 1.0) * env.height_fog_color.a;
        color = mix(color, env.height_fog_color.rgb, hf);
    }

    if (globals.misc.w > 0.5) {
        color = grade(color, env.hemi_sky.a, env.chara_hemi_sky.a, env.hemi_ground.a);
    }
    if (globals.misc.y > 0.5) {
        color = soft_clip(color);
    }

    // ---- Debug views (MK8_RENDER_DEBUG / Renderer::debug_view) ----
    let dbg = u32(globals.params.z + 0.5);
    if (dbg == 1u) {
        color = albedo.rgb;
    } else if (dbg == 2u) {
        color = n * 0.5 + vec3<f32>(0.5);
    } else if (dbg == 3u) {
        color = vec3<f32>(ao);
    } else if (dbg == 4u) {
        color = vec3<f32>(shadow);
    } else if (dbg == 5u) {
        color = bake_light;
    } else if (dbg == 6u) {
        color = soft_clip(light * env.sun_dir.w);
    } else if (dbg == 7u) {
        color = vec3<f32>(fract(b0uv), 0.0);
    } else if (dbg == 8u) {
        color = i.color.rgb;
    } else if (dbg == 9u) {
        color = s_b1.rgb;
    } else if (dbg == 10u) {
        color = vec3<f32>(s_b1.a);
    }

    var alpha = 1.0;
    if (has(F_TRANSLUCENT)) {
        alpha = clamp(albedo.a, 0.0, 1.0);
    }
    return finish(color, alpha);
}
