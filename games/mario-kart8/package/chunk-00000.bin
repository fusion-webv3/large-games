mx_sat// Saturate to [+0, 1]; NaN and -0 give +0.
fn mx_sat(x: f32) -> f32 {
    return select(0.0, min(x, 1.0), x > 0.0);
}mx_fminfn mx_fmin(a: f32, b: f32) -> f32 {
    if (a != a) { return b; }
    if (b != b) { return a; }
    return min(a, b);
}mx_fmaxfn mx_fmax(a: f32, b: f32) -> f32 {
    if (a != a) { return b; }
    if (b != b) { return a; }
    return max(a, b);
}mx_fmul_fmzfn mx_fmul_fmz(a: f32, b: f32) -> f32 {
    return select(a * b, 0.0, a == 0.0 || b == 0.0);
}mx_f2ifn mx_f2i(x: f32) -> u32 {
    if (x != x) { return 0u; }
    if (x >= 2147483648.0) { return 0x7fffffffu; }
    if (x <= -2147483648.0) { return 0x80000000u; }
    return bitcast<u32>(i32(x));
}mx_f2ufn mx_f2u(x: f32) -> u32 {
    if (!(x > 0.0)) { return 0u; }
    if (x >= 4294967296.0) { return 0xffffffffu; }
    return u32(x);
}mx_next_downfn mx_next_down(f: f32) -> f32 {
    let b = bitcast<u32>(f);
    if (f > 0.0) { return bitcast<f32>(b - 1u); }
    if (f == 0.0) { return bitcast<f32>(b | 0x80000001u); }
    return bitcast<f32>(b + 1u);
}mx_next_upfn mx_next_up(f: f32) -> f32 {
    let b = bitcast<u32>(f);
    if (f > 0.0) { return bitcast<f32>(b + 1u); }
    if (f == 0.0) { return bitcast<f32>((b & 0u) | 1u); }
    return bitcast<f32>(b - 1u);
}mx_i2f_dir␀ã␀␀␀␀e␀
␀␀␀// Integer to float with directed rounding (1 = toward -inf, 2 = toward +inf, 3 = toward 0).
fn mx_i2f_dir(x: i32, mode: u32) -> f32 {
    let f = f32(x);
    var above = false;
    var below = false;
    if (f >= 2147483648.0) {
        above = true;
    } else {
        let back = i32(f);
        above = back > x;
        below = back < x;
    }
    if ((mode == 1u && above) || (mode == 3u && x >= 0 && above)) { return mx_next_down(f); }
    if ((mode == 2u && below) || (mode == 3u && x < 0 && below)) { return mx_next_up(f); }
    return f;
}mx_u2f_dirfn mx_u2f_dir(x: u32, mode: u32) -> f32 {
    let f = f32(x);
    var above = false;
    var below = false;
    if (f >= 4294967296.0) {
        above = true;
    } else {
        let back = u32(f);
        above = back > x;
        below = back < x;
    }
    if ((mode == 1u || mode == 3u) && above) { return mx_next_down(f); }
    if (mode == 2u && below) { return mx_next_up(f); }
    return f;
}mx_fmul_dir// Product with directed rounding (1 = toward -inf, 2 = toward +inf, 3 = toward 0): the
// residual of the round-to-nearest product comes from a fused multiply-add.
fn mx_fmul_dir(a: f32, b: f32, mode: u32) -> f32 {
    let p = a * b;
    if (!(abs(p) <= 3.40282347e38)) {
        // inf/NaN: an overflowing finite product rounds to the largest finite value.
        if (p == p && abs(a) <= 3.40282347e38 && abs(b) <= 3.40282347e38
            && (mode == 3u || (mode == 1u && p > 0.0) || (mode == 2u && p < 0.0))) {
            return select(-3.40282347e38, 3.40282347e38, p > 0.0);
        }
        return p;
    }
    if (abs(p) < 1.17549435e-38) { return p; }
    let e = fma(a, b, -p);
    if ((mode == 1u && e < 0.0) || (mode == 3u && p > 0.0 && e < 0.0)) { return mx_next_down(p); }
    if ((mode == 2u && e > 0.0) || (mode == 3u && p < 0.0 && e > 0.0)) { return mx_next_up(p); }
    return p;
}mx_fadd_dir// Sum with directed rounding; the exact error of the round-to-nearest sum (TwoSum).
fn mx_fadd_dir(a: f32, b: f32, mode: u32) -> f32 {
    let s = a + b;
    if (!(abs(s) <= 3.40282347e38)) {
        if (s == s && abs(a) <= 3.40282347e38 && abs(b) <= 3.40282347e38
            && (mode == 3u || (mode == 1u && s > 0.0) || (mode == 2u && s < 0.0))) {
            return select(-3.40282347e38, 3.40282347e38, s > 0.0);
        }
        return s;
    }
    if (abs(s) < 1.17549435e-38) { return s; }
    let bb = s - a;
    let e = (a - (s - bb)) + (b - bb);
    if ((mode == 1u && e < 0.0) || (mode == 3u && s > 0.0 && e < 0.0)) { return mx_next_down(s); }
    if ((mode == 2u && e > 0.0) || (mode == 3u && s < 0.0 && e > 0.0)) { return mx_next_up(s); }
    return s;
}mx_iadd_satfn mx_iadd_sat(a: u32, b: u32) -> u32 {
    let r = a + b;
    if ((((a ^ r) & (b ^ r)) >> 31u) != 0u) {
        return select(0x7fffffffu, 0x80000000u, (a >> 31u) != 0u);
    }
    return r;
}mx_mulhi_ufn mx_mulhi_u(a: u32, b: u32) -> u32 {
    let al = a & 0xffffu;
    let ah = a >> 16u;
    let bl = b & 0xffffu;
    let bh = b >> 16u;
    let ll = al * bl;
    let lh = al * bh;
    let hl = ah * bl;
    let mid = (ll >> 16u) + (lh & 0xffffu) + (hl & 0xffffu);
    return ah * bh + (lh >> 16u) + (hl >> 16u) + (mid >> 16u);
}mx_mulhi_s␀␀~␀
␀␀␀fn mx_mulhi_s(a: u32, b: u32) -> u32 {
    var r = mx_mulhi_u(a, b);
    if (bitcast<i32>(a) < 0) { r = r - b; }
    if (bitcast<i32>(b) < 0) { r = r - a; }
    return r;
}mx_shf_lfn mx_shf_l(lo: u32, s: u32, hi: u32) -> u32 {
    if (s == 0u) { return hi; }
    if (s >= 32u) { return lo; }
    return (hi << s) | (lo >> (32u - s));
}mx_shf_rfn mx_shf_r(lo: u32, s: u32, hi: u32) -> u32 {
    if (s == 0u) { return lo; }
    if (s >= 32u) { return hi; }
    return (lo >> s) | (hi << (32u - s));
}mx_brevfn mx_brev(x: u32) -> u32 {
    var v = x;
    v = ((v >> 1u) & 0x55555555u) | ((v & 0x55555555u) << 1u);
    v = ((v >> 2u) & 0x33333333u) | ((v & 0x33333333u) << 2u);
