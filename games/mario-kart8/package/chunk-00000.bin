LLIn_FadeInBlackInWhiteOut_Fade␀"!#(˛␀J˛␀d˛␀Ö˛␀␀␀␀␀␀␀Ä?␀␀␀@␀␀@@␀␀Ä@␀␀†@␀␀¿@␀␀‡@␀␀␀A␀␀Amk8-ui samplermk8-ui globals bgmk8-ui capture backdrop␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀?mk8-ui capture␀␀␀␀␀␀␀␀␀␀␀␀␀mk8-ui capture blur␀7j␀␀␀␀ª␀␀%␀␀␀7j␀␀␀␀ˆ␀␀1␀␀␀7j␀␀␀␀ˆ␀␀␀␀␀7j␀␀␀␀˙␀␀*␀␀␀mk8-ui post bgmk8-ui materialsmk8-ui capture tempmk8-ui shader// nn::ui2d-style material shader for MK8D layouts.
//
// colour = combine(tex0, tex1, tex2) * width + offset, times the vertex colour, where
// width = white - black and offset = black (or white / 0 without textures). Combiner stages
// merge the previous result with the next texture: Replace takes the new texture, Modulate
// multiplies, Add / Subtract / Dodge / Burn / Lighten / Darken as named, and the indirect
// modes displace texture 0's coordinates by texture 1's red/green channels.
// Text samples a one-channel border font sheet: the upper half of the coverage range is the
// fill (white colour), the lower half the border (black colour).

struct Globals {
    proj: mat4x4<f32>,
    // x: 1 = target is sRGB (output must be linearised), y/z/w unused
    params: vec4<f32>,
};

struct Material {
    width: vec4<f32>,
    offset: vec4<f32>,
    modes: vec4<i32>,
    modes2: vec4<i32>,
    ind0: vec4<f32>,
    ind1: vec4<f32>,
    misc: vec4<f32>,
};

@group(0) @binding(0) var<uniform> g: Globals;
@group(0) @binding(1) var<uniform> mat: Material;
@group(1) @binding(0) var t0: texture_2d<f32>;
@group(1) @binding(1) var s0: sampler;
@group(1) @binding(2) var t1: texture_2d<f32>;
@group(1) @binding(3) var s1: sampler;
@group(1) @binding(4) var t2: texture_2d<f32>;
@group(1) @binding(5) var s2: sampler;

struct VsIn {
    @location(0) pos: vec2<f32>,
    @location(1) color: vec4<f32>,
    @location(2) uv0: vec2<f32>,
    @location(3) uv1: vec2<f32>,
    @location(4) uv2: vec2<f32>,
};

struct VsOut {
    @builtin(position) pos: vec4<f32>,
    @location(0) color: vec4<f32>,
    @location(1) uv0: vec2<f32>,
    @location(2) uv1: vec2<f32>,
    @location(3) uv2: vec2<f32>,
};

@vertex
fn vs_main(v: VsIn) -> VsOut {
    var o: VsOut;
    o.pos = g.proj * vec4<f32>(v.pos, 0.0, 1.0);
    o.color = v.color;
    o.uv0 = v.uv0;
    o.uv1 = v.uv1;
    o.uv2 = v.uv2;
    return o;
}

fn op3(mode: i32, p: vec3<f32>, n: vec3<f32>, nb: f32) -> vec3<f32> {
    switch mode {
        case 0: { return n; }
        case 1: { return p * n; }
        case 2: { return p + n; }
        case 3: { return p + n - vec3<f32>(0.5); }
        case 5: { return p - n; }
        case 6: { return p / max(vec3<f32>(1.0) - n, vec3<f32>(0.0001)); }
        case 7: { return vec3<f32>(1.0) - (vec3<f32>(1.0) - p) / max(n, vec3<f32>(0.0001)); }
        case 8: { return max(p, n); }
        case 9: { return min(p, n); }
        case 10, 11: { return p; }
        case 12: { return p * nb; }
        default: { return p; }
    }
}

fn op1(mode: i32, p: f32, n: f32) -> f32 {
    switch mode {
        case 0: { return n; }
        case 1: { return p * n; }
        case 2: { return p + n; }
        case 3: { return p + n - 0.5; }
        case 5: { return p - n; }
        case 6: { return p / max(1.0 - n, 0.0001); }
        case 7: { return 1.0 - (1.0 - p) / max(n, 0.0001); }
        case 8: { return max(p, n); }
        case 9: { return min(p, n); }
        default: { return p; }
    }
}

fn srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
    let lo = c / 12.92;
    let hi = pow((c + vec3<f32>(0.055)) / 1.055, vec3<f32>(2.4));
    return select(hi, lo, c <= vec3<f32>(0.04045));
}

fn alpha_test(func: i32, a: f32, r: f32) -> bool {
    switch func {
        case 0: { return false; }
        case 1: { return a < r; }
        case 2: { return a <= r; }
        case 3: { return a == r; }
        case 4: { return a != r; }
        case 5: { return a >= r; }
        case 6: { return a > r; }
        default: { return true; }
    }
}

@fragment
fn fs_main(i: VsOut) -> @location(0) vec4<f32> {
    let n = mat.modes.x;
    let stages = mat.modes2.y;
    let c1 = textureSample(t1, s1, i.uv1);
    let c2 = textureSample(t2, s2, i.uv2);
    var uv0 = i.uv0;
    if (stages >= 1 && mat.modes.y >= 10) {
        let rg = vec3<f32>(c1.r, c1.g, 1.0);
        uv0 = uv0 + vec2<f32>(dot(mat.ind0.xyz, rg), dot(mat.ind1.xyz, rg));
    }
    let c0 = textureSample(t0, s0, uv0);
    var out: vec4<f32>;
    if (mat.modes2.z > 0) {
        // Border font sheet.
        let t = c0.r;
        let cov = clamp(t * 2.0, 0.0, 1.0);
        let fill = clamp(t * 2.0 - 1.0, 0.0, 1.0);
        let col = mat.offset + mat.width * fill;
        var a = col.a * cov;
        if (mat.modes2.z == 2) {
            a = (mat.offset.a + mat.width.a) * fill;
        }
        out = vec4<f32>(col.rgb, a);
    } else if (n == 0) {
        out = mat.width + mat.offset;
    } else {
        var c = c0;
        if (stages >= 1 && n >= 2) {
            c = vec4<f32>(op3(mat.modes.y, c.rgb, c1.rgb, c1.b), op1(mat.modes.z, c.a, c1.a));
        }
        if (stages >= 2 && n >= 3) {
            c = vec4<f32>(op3(mat.modes.w, c.rgb, c2.rgb, c2.b), op1(mat.modes2.x, c.a, c2.a));
        }
        c = clamp(c, vec4<f32>(0.0), vec4<f32>(1.0));
        out = clamp(c * mat.width + mat.offset, vec4<f32>(0.0), vec4<f32>(1.0));
    }
    out = out * i.color;
    if (!alpha_test(mat.modes2.w, out.a, mat.misc.x)) {
        discard;
    }
    if (g.params.x > 0.5) {
        out = vec4<f32>(srgb_to_linear(clamp(out.rgb, vec3<f32>(0.0), vec3<f32>(1.0))), out.a);
    }
    return out;
}
mk8-ui globalsmk8-ui texturesmk8-ui pipeline layoutmk8-ui post shader// Capture post-processing: copy (with UV transform) and separable gaussian blur.

struct Params {
    // xy: blur direction in texels (0 = copy), zw: source texel size
    dir: vec4<f32>,
    // xy: uv scale, zw: uv offset (applied to the destination uv to address the source)
    uv: vec4<f32>,
    // x: sigma in texels, y: alpha override (< 0 = keep), z: flip v (1 = yes)
    misc: vec4<f32>,
};

@group(0) @binding(0) var<uniform> p: Params;
@group(0) @binding(1) var src: texture_2d<f32>;
@group(0) @binding(2) var smp: sampler;

struct VsOut {
    @builtin(position) pos: vec4<f32>,
    @location(0) uv: vec2<f32>,
};

@vertex
fn vs_main(@builtin(vertex_index) i: u32) -> VsOut {
    var o: VsOut;
    let x = f32((i << 1u) & 2u);
    let y = f32(i & 2u);
    o.pos = vec4<f32>(x * 2.0 - 1.0, 1.0 - y * 2.0, 0.0, 1.0);
    // uv (0,0) = top-left of the destination.
    o.uv = vec2<f32>(x, y);
    return o;
}

@fragment
fn fs_main(i: VsOut) -> @location(0) vec4<f32> {
    var uv = i.uv * p.uv.xy + p.uv.zw;
    if (p.misc.z > 0.5) {
        uv.y = 1.0 - uv.y;
    }
    var c = vec4<f32>(0.0);
    let sigma = p.misc.x;
    if (sigma <= 0.0) {
        c = textureSampleLevel(src, smp, uv, 0.0);
    } else {
        var wsum = 0.0;
        let step = p.dir.xy * p.dir.zw;
        for (var k = -12; k <= 12; k = k + 1) {
            let fk = f32(k) * max(sigma / 4.0, 1.0);
            let w = exp(-0.5 * fk * fk / (sigma * sigma));
            c = c + textureSampleLevel(src, smp, uv + step * fk, 0.0) * w;
            wsum = wsum + w;
        }
        c = c / wsum;
    }
    if (p.misc.y >= 0.0) {
        c.a = p.misc.y;
    }
    return c;
}
